# Arquivo de secrets consumido por infra/prod/ec2-frontend/user-data.sh
# Nunca preencha este arquivo com valores reais no repositório.
# Em produção, copie para /etc/iselftoken/ec2-frontend.env na EC2,
# aplique owner root:root e modo 600 antes de executar o user-data.

# GitHub — prefira Deploy Key/App em vez de PAT quando possível
GITHUB_USER=
GITHUB_TOKEN=
GITHUB_REPO=https://github.com/iSelfToken/frontend.git

# Aplicação
API_URL=https://api.iselftoken.com

# CSRF / allowedActionOrigins (Sprint S34 — fix bug /admin/startups/:id/:phase
# retornando 400). React Router 7 consulta esta lista em BUILD TIME para
# validar Origin vs Host em requests de action (POST/PUT/PATCH/DELETE em
# rotas UI). Lista padrão cobre dev local + prod, mas setar explicitamente
# garante que o build de prod tem o valor correto mesmo se os defaults
# forem alterados no react-router.config.ts.
#
# Wildcards: * (1 segmento DNS) e ** (multiplos segmentos, só no início).
# **.iselftoken.com NÃO casa iselftoken.com (domínio raiz); liste ambos.
#
# Diagnóstico: node scripts/check-csrf-config.mjs
# Docs: frontend/react-router.config.ts (comentário grande no topo)
ALLOWED_ACTION_ORIGINS=iselftoken.com,www.iselftoken.com,**.iselftoken.com
