# Arquivo de secrets consumido por infra/prod/ec2-api/user-data.sh
#
# Nunca preencha este arquivo com valores reais no repositório.
# Em produção, copie para /etc/iselftoken/ec2-api.env na EC2,
# aplique owner root:root e modo 600 antes de executar o user-data.
# Valores shell com caracteres especiais devem ser devidamente quoted.

# GitHub — prefira Deploy Key/App em vez de PAT quando possível
GITHUB_USER=
GITHUB_TOKEN=
GITHUB_REPO=https://github.com/iSelfToken/backendnode.git

# Aplicação
JWT_SECRET=
WEBHOOK_HASH_SECRET=
FRONTEND_URL=https://iselftoken.com
BACKEND_PUBLIC_URL=https://api.iselftoken.com

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=

# SMTP / AWS SES
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@iselftoken.com
AWS_SES_FROM_EMAIL=noreply@iselftoken.com
AWS_SES_CONFIGURATION_SET=iselftoken-prod
AWS_REGION=us-east-1

# AWS S3: deixe vazio para usar IAM Role da EC2 (recomendado)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_PREFIX=iselftoken
S3_PUBLIC_BASE_URL=
S3_PUBLIC_HOST=

# Webhook EFI em modo mock no provisionamento atual
EFI_WEBHOOK_HMAC_SECRET=
