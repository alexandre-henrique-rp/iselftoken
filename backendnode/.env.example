DATABASE_URL="file:./prisma/dev.db"
DATABASE_PROVIDER=sqlite

# Gere um valor aleatório com: openssl rand -base64 48
# Não use placeholders; sem valor válido o backend deve falhar no bootstrap.
JWT_SECRET=""
# Gere um valor separado com: openssl rand -base64 48
WEBHOOK_HASH_SECRET=""
JWT_EXPIRES_IN="30m"

# AWS SES SMTP Configuration
SMTP_HOST="email-smtp.us-east-2.amazonaws.com"
SMTP_PORT=587
SMTP_USER="your-ses-smtp-user"
SMTP_PASS="your-ses-smtp-password"
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM_EMAIL="noreply@example.com"
# Email de reply-to (aparece como "Responder para" no cliente de email)
SMTP_REPLY_TO="replyto@example.com"
# Use false somente após liberar o SES para produção; habilita cópias para destinatários internos
AWS_SES_SANDBOX=true

# Emails de cópia (CC) para monitoramento — todos os emails transacionais recebem cópia
# Formato: CSV (email1@example.com,email2@example.com)
# O destinatário principal é automaticamente excluído do CC para evitar duplicidade.
EMAIL_CC_LIST="email1@example.com,email2@example.com"

# Destinatário de seed exibido no cabeçalho, mas não entregável (para testes)
SMTP_NON_DELIVERABLE_RECIPIENTS="founder@example.com"

FRONTEND_URL="http://localhost:5173"

# CORS do socket.io (realtime, namespace /notifications).
# Opcional. CSV de origens permitidas no handshake WS. Fallback:
# FRONTEND_URL, depois http://localhost:5173. Em produção, liste as
# origens do frontend (deve bater com VITE_WS_URL do frontend).
# Ex.: SOCKET_IO_CORS_ORIGINS=https://app.seu-dominio.com.br,https://www.seu-dominio.com.br
SOCKET_IO_CORS_ORIGINS=http://localhost:5173

# Backend public URL (usado em URLs de upload/download)
BACKEND_PUBLIC_URL="http://localhost:7077"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# AWS S3
S3_BUCKET_PREFIX=iselftoken
S3_PUBLIC_BASE_URL=
S3_PUBLIC_HOST=s3.sa-east-1.amazonaws.com

# CORS — origens permitidas para acesso direto ao object storage pelo browser.
# O bucket S3 precisa ter CORS configurado com essas origens (separado do CORS da API).
# Exemplo de CORS no S3 (JSON):
#   [{"AllowedHeaders":["*"],"AllowedMethods":["GET","HEAD"],"AllowedOrigins":["http://localhost:5173"],"ExposeHeaders":["ETag"],"MaxAgeSeconds":3000}]
S3_CORS_ORIGINS=http://localhost:5173

# Upload presigned URL TTL (segundos) — 7 dias
UPLOAD_PRESIGNED_URL_TTL=604800

# API
PORT=7077

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_RELEASE=

# EFI Bank (pagamentos) — integração via SDK oficial sdk-node-apis-efi
# Modo de operação: mock (default em dev) | sandbox (homologação) | prod
# O SDK escolhe o endpoint (pix-h.api.efipay.com.br em sandbox, pix.api.efipay.com.br em prod).
EFI_MODE=mock
EFI_BASE_URL=https://api-pix-h.gerencianet.com.br
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_AUTH=
EFI_PIX_KEY=
# URL PÚBLICA ABSOLUTA do webhook (https). Ex.: https://api.seu-dominio.com.br/payment/efi/webhook
# Usada por POST /payment/efi/webhook/configure (o backend acrescenta ?hmac=&ignorar=).
EFI_WEBHOOK_URL=
EFI_DEFAULT_SPLIT_ID=
# Certificados mTLS (.p12) — sandbox usa o de homologação, prod usa o de produção.
# Se não informados, o padrão é backendnode/certs/efi/{homologacao,producao}-*.p12
EFI_CERT_HOMOLOG_PATH=
EFI_CERT_PROD_PATH=
