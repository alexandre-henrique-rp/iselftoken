{
  "name": "backendnode",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "overrides": {
    "@prisma/client-runtime-utils": "7.8.0",
    "@prisma/driver-adapter-utils": "7.8.0"
  },
  "onlyBuiltDependencies": [
    "better-sqlite3",
    "prisma",
    "@prisma/client",
    "@prisma/adapter-better-sqlite3",
    "@prisma/engines",
    "sharp",
    "bcrypt",
    "@nestjs/core",
    "@swc/core",
    "msgpackr-extract",
    "@scarf/scarf",
    "puppeteer"
  ],
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.js",
    "test:e2e:flows": "jest --config ./test/e2e/jest-e2e-flows.config.js",
    "postinstall": "node scripts/sync-prisma-client.js",
    "prisma:sync": "node scripts/sync-prisma-client.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:setup": "pnpm run prisma:generate && pnpm run prisma:sync",
    "seed": "ts-node prisma/seed.ts",
    "db:seed": "pnpm run seed",
    "seed:assets": "ts-node prisma/seeds/seed-assets.ts",
    "seed:location": "ts-node prisma/seeds/seed-location.ts",
    "seed:opinions": "ts-node prisma/seeds/seed-opinions.ts",
    "seed:curated": "ts-node prisma/seeds/seed-curated.ts",
    "seed:config": "ts-node prisma/seeds/seed-system-config.ts",
    "seed:emails": "ts-node prisma/seed-email-templates.ts",
    "seed:premium": "ts-node prisma/seed-premium-seals.ts",
    "email:test": "node -r tsconfig-paths/register -r ts-node/register scripts/send-test-email.ts",
    "openapi:dump": "curl -fsS http://localhost:${PORT:-7077}/docs-json | python3 -m json.tool --sort-keys > docs/openapi.json",
    "pki:init": "ts-node scripts/pki-bootstrap.ts",
    "pki:vault:init": "ts-node scripts/pki-vault-bootstrap.ts",
    "smoke:e2e": "ts-node scripts/smoke-test-e2e-termo.ts",
    "backfill:categoria-area": "tsx scripts/backfill-categoria-area.ts",
    "backfill:categoria-area:dry": "tsx scripts/backfill-categoria-area.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/client-ses": "^3.967.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@golevelup/nestjs-rabbitmq": "5.7.0",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.2.0",
    "@scalar/nestjs-api-reference": "^1.1.9",
    "@sentry/nestjs": "^10.46.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "fluent-ffmpeg": "^2.1.3",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "multer": "^2.0.0",
    "mysql2": "^3.23.0",
    "node-forge": "^1.3.1",
    "node-signpdf": "^1.5.1",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sdk-node-apis-efi": "^2.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.4",
    "undici": "^8.2.0",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.17",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "md-to-pdf": "^5.2.5",
    "prettier": "^3.0.0",
    "prisma": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^uuid$": "<rootDir>/../jest.setup.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}