/// Configuracao dinamica do sistema. Permite ajustar taxas/limites sem deploy.
/// Apenas ADMIN/FINANCEIRO pode modificar via PATCH /admin/configs/:key.
/// Usado por campanhas (ADR-008) — backend e source-of-truth dos calculos.
/// Decimal(15,4) proposital: algumas configs podem ter precisao > 2 casas
/// (ex: percentuais como 0.2050).
model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Decimal
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   Int? // User ID que alterou (log-only, sem FK)

  @@map("system_configs")
}

// Parâmetros de cálculo (taxas, percentuais, limites) com VIGÊNCIA POR DATA.
// Append-only: cada alteração é uma nova versão com `effectiveFrom`. O valor
// vigente numa data D é a versão de maior `effectiveFrom <= D`. Versões passadas
// nunca são alteradas — por isso cálculos passados não mudam. Uma versão com
// `effectiveFrom` no futuro é uma alteração agendada, que passa a valer sozinha.
model ConfigParameterValue {
  id            Int      @id @default(autoincrement())
  key           String
  value         String
  effectiveFrom DateTime
  note          String?
  createdById   Int?
  createdAt     DateTime @default(now())

  @@index([key, effectiveFrom])
  @@map("config_parameter_values")
}

// ==========================================
// Cupons de desconto (B04)
// ==========================================

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

model Coupon {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  percent     Int // validado em [20, 30, 50, 60, 100]
  maxUses     Int? // null = ilimitado, 1 = uso único, N>1 = limitado
  usedCount   Int           @default(0)
  validFrom   DateTime? // null = válido desde sempre
  validUntil  DateTime? // null = nunca expira
  active      Boolean       @default(true)
  status      CouponStatus  @default(ACTIVE)
  description String? // VarChar(500) em MySQL
  createdById Int
  createdBy   User          @relation("CouponCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  usages      CouponUsage[]

  @@index([active])
  @@index([validUntil])
  @@index([percent])
  @@map("coupons")
}

model CouponUsage {
  id              Int      @id @default(autoincrement())
  couponId        Int
  coupon          Coupon   @relation(fields: couponId, references: [id])
  userId          Int // FK obrigatória — auditoria LGPD
  user            User     @relation("CouponUsageUser", fields: userId, references: [id])
  paymentId       Int? // nullable (cupom sem payment imediato)
  payment         Payment? @relation(fields: paymentId, references: [id])
  discountApplied Decimal
  originalAmount  Decimal
  finalAmount     Decimal
  appliedAt       DateTime @default(now())

  @@unique([couponId, paymentId])
  @@index([userId])
  @@index([couponId])
  @@map("coupon_usages")
}

// ==========================================
// Serviços — catálogo gerenciado pelo admin
// ==========================================
//
// Cada Service representa um serviço pago que o founder pode contratar
// para uma de suas startups. O endpoint founder lê só os `available=true`,
// ordenando por `order ASC` + `highlight DESC`. O admin CRUD usa o mesmo
// model com guard AdminGuard (ver admin/services.controller.ts).
//
// Os campos `endpoint` e `requiresCampaignStatus` controlam o gate
// client-side (botão CTA + select de startup elegíveis). Quando o founder
// confirma, o frontend dispara a mutation correspondente (ver
// `use-founder-service-requests.ts`).

model Service {
  id                     Int      @id @default(autoincrement())
  slug                   String   @unique
  name                   String
  shortDesc              String? // 1 linha para cards
  description            String // descricao longa (markdown leve)
  benefits               String? // JSON array de strings (bullets)
  category               String // FAST_TRACK | COMPLIANCE | SEAL | EXTENSION | EARLY_ACCESS | OTHER
  paymentPurpose         String // PaymentPurpose correspondente (gera o Payment via mutacao)
  price                  Decimal? // null = varia por contexto (ex.: prorrogacao)
  currency               String   @default("BRL")
  highlight              Boolean  @default(false) // servico padrao, exibido no topo
  available              Boolean  @default(true)
  order                  Int      @default(0)
  requiresCampaignStatus String? // JSON array de campaign status permitidos (gate client-side)
  endpoint               String? // path BFF para a mutation (ex.: /api/founder/compliance-fee)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([available, order])
  @@map("services")
}

