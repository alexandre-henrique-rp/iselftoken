  key             String?
  sha256          String?          @map("sha256") // hash SHA-256 do conteudo
  variants        Json? // { lg: {...}, md: {...}, sm: {...} }
  status          UploadStatus     @default(PENDING)
  fileKey         String?
  url             String?
  url_md          String?
  url_web         String?
  documentType    String?
  applicancy      UploadApplicancy @default(APPLICABLE)
  rejectionReason String?

  /// Anexos de posts de transparencia que referenciam este upload.
  transparencyPostAttachments TransparencyPostAttachment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([startupId])
  @@index([userId])
  @@index([sha256])
  @@index([status])
  @@index([deletedAt])
}

model StartupSeal {
  id        Int      @id @default(autoincrement())
  startupId Int
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  sealId    Int
  seal      Seal     @relation(fields: [sealId], references: [id], onDelete: Cascade)
  issuedBy  Int?
  issuedAt  DateTime @default(now())
  metadata  Json?

