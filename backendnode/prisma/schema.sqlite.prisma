// ==========================================
// 12. PKI — Certificate Authority Interna
// ==========================================
// Modelo para persistir CAs internas (Root + Intermediate) do termo de adesao digital.
// As chaves privadas sao armazenadas no HashiCorp Vault (ou stub in-memory em dev).
// As chaves privadas JAMAIS devem ser armazenadas em plaintext no banco de dados.

model CertificateAuthority {
  id String @id @default(cuid())

  // Tipo da CA: Root (auto-assinada) ou Intermediate (assinada pela Root)
  type String // 'root' | 'intermediate'

  // Hierarquia: Intermediate CA aponta para a Root CA
  parentCaId String?                @map("parent_ca_id")
  parentCa   CertificateAuthority?  @relation("CaHierarchy", fields: [parentCaId], references: [id])
  children   CertificateAuthority[] @relation("CaHierarchy")

  // Certificados digitais emitidos por esta CA
  issuedCertificates DigitalCertificate[]

  // Certificado X.509 em formato PEM
  certificatePem String @map("certificate_pem")

  // Referencia para a chave privada no Vault (path, NAO o conteudo da chave)
  // Ex: iselftoken/pki/root/private ou iselftoken/pki/intermediate/private
  privateKeyRef String @map("private_key_ref")

  // Validade do certificado
  issuedAt  DateTime @default(now()) @map("issued_at")
  expiresAt DateTime @map("expires_at")

  // Status: active (valido) ou revoked (revogado)
  status String @default("active") // 'active' | 'revoked'

  // Dados do certificado para consulta rapida
  commonName   String @map("common_name")
  organization String @default("Iselftoken")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([commonName])
  @@map("certificate_authority")
}

// ==========================================
// 13. PKI — Digital Certificates (Termo de Adesao)
// ==========================================
// Modelo para certificados digitais emitidos pela Intermediate CA.
// Cada certificado pertence a um owner (founder ou startup) e eh usado
// para assinar digitalmente o Termo de Adesao.

model DigitalCertificate {
  id String @id @default(cuid())

  // CA emissora (Intermediate CA)
  issuerCaId String
  issuerCa   CertificateAuthority @relation(fields: [issuerCaId], references: [id])

  // Dono do certificado
  ownerType String // 'founder' | 'startup'
  ownerId   String // ID do founder (user.id) ou startup (startup.id)

  // Dados do certificado
  serialNumber         String @unique // Serial number unico do certificado
  certificatePem       String // Certificado X.509 em formato PEM
  privateKeyRef        String // Referencia ao path da chave privada no KeyStorageService
  publicKeyFingerprint String // SHA-256 da chave publica (DER encoded, hex)

  // Validade
  issuedAt  DateTime @default(now())
  expiresAt DateTime

  // Status: active (valido), revoked (revogado), expired (expirado)
  status String @default("active") // 'active' | 'revoked' | 'expired'

  // Revogacao
  revokedAt        DateTime?
  revocationReason String?

  // Assinaturas que usam este certificado (founder)
  founderSignedDocuments SignedDocument[] @relation("FounderSignedCert")
  // Assinaturas que usam este certificado (startup)
  startupSignedDocuments SignedDocument[] @relation("StartupSignedCert")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerType, ownerId, status])
  @@index([expiresAt, status])
  @@map("digital_certificate")
}

// ==========================================
// 14. TERMO DE ADESAO — Documentos Assinados (M6-S18)
// ==========================================
// Modelo para persistir documentos assinados digitalmente (Termo de Adesao).
// Cada documento tem 2 assinaturas PAdES (founder + startup).
// Ref: S18.4-termo-adesao

model SignedDocument {
  id                     String              @id @default(cuid())
  startupId              Int
  startup                Startup             @relation(fields: [startupId], references: [id])
  founderId              Int // user.id que aceitou
  type                   String // 'termo_adesao'
  templateVersion        String // '1.0.0'
  fileKey                String // S3 key do PDF
  documentHash           String // SHA-256 do PDF final (apos assinatura)
  signatureFounderCertId String
  signatureFounderCert   DigitalCertificate  @relation("FounderSignedCert", fields: [signatureFounderCertId], references: [id])
  signatureFounderAt     DateTime            @default(now())
  signatureStartupCertId String
  signatureStartupCert   DigitalCertificate  @relation("StartupSignedCert", fields: [signatureStartupCertId], references: [id])
  signatureStartupAt     DateTime            @default(now())
  createdAt              DateTime            @default(now())
  audits                 SignatureAuditLog[]

  @@unique([startupId, type, founderId]) // idempotente: 1 termo por startup+founder
  @@index([startupId])
  @@map("signed_document")
}

model SignatureAuditLog {
  id               String          @id @default(cuid())
  signedDocumentId String?
  signedDocument   SignedDocument? @relation(fields: [signedDocumentId], references: [id])
  actorType        String // 'founder' | 'startup' | 'system'
  action           String // 'aceite_checkbox' | 'certificado_emitido' | 'documento_assinado' | 'documento_visualizado' | 'documento_verificado_publico'
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime        @default(now())

  @@index([signedDocumentId])
  @@index([action, createdAt])
  @@map("signature_audit_log")
}

// ==========================================
// 15. AUDITORIA — HARD DELETE de Startups (Compliance M6-S17)
// ==========================================
// Log imutavel (append-only) de exclusao HARD de startups pelo role compliance.
// Snapshot completo do registro + hash SHA-256 antes do delete em cascata.
// Retido por 7 anos (LGPD + obrigacao contabilidade brasil).
// Ref: S17-compliance-delete

model StartupDeleteAuditLog {
  id String @id @default(cuid())

  // ID da startup que foi excluida
  startupId String @map("startup_id")

  // Snapshots JSON (stringified) antes do delete
  startupSnapshot     String  @map("startup_snapshot") // Registro completo da startup
  rodadaSnapshot      String? @map("rodada_snapshot") // JSON da rodada ativa (se houver)
  investmentsSnapshot String? @map("investments_snapshot") // JSON de investments ativos
  paymentsSnapshot    String? @map("payments_snapshot") // JSON de payments
  documentsSnapshot   String? @map("documents_snapshot") // JSON de StartupDocument
  signedDocsSnapshot  String? @map("signed_docs_snapshot") // JSON de SignedDocument (S18) — protegidos

  // Metadados da exclusao
  deletedByUserId String   @map("deleted_by_user_id") // User ID do compliance que executou
  deletedByRole   String   @map("deleted_by_role") // Role: 'COMPLIANCE' no M6
  deletedAt       DateTime @default(now()) @map("deleted_at")
  ipAddress       String?  @map("ip_address") // IP do request
  userAgent       String?  @map("user_agent") // User-Agent do browser
  reason          String? // Motivo opcional informado pelo compliance

  // Retencao: 7 anos (LGPD + contabilidade)
  retentionUntil DateTime @map("retention_until")

  // Timestamps (sem updatedAt — log imutavel)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([startupId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@map("startup_delete_audit_log")
}

// ==========================================
// 16. SOLICITAÇÃO DE ALTERAÇÃO DE DADOS BLOQUEADOS (B13)
