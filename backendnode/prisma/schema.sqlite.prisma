// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// ==========================================
// DUAL DATABASE CONFIGURATION
// ==========================================
// Para usar SQLite em dev, set DATABASE_PROVIDER=sqlite
// Para usar MySQL em prod, set DATABASE_PROVIDER=mysql
//
// AVISO: Decimal e Json em SQLite sao armazenados como TEXT.
// Calculos monetarios devem usar Prisma.Decimal API.
// Queries JSON nativas nao funcionam em SQLite.
//
// ==========================================
// DECIMAL — convencoes SQLite (P3.4)
// ==========================================
// - Storage: TEXT (ex.: "100.50")
// - Precision: 18 digitos significativos + ate 8 casas decimais (padrao Prisma)
// - Operacoes: sempre usar `Prisma.Decimal` ou `new Decimal(value)` para
//   aritmetica. `Number(value)` perde precisao para valores monetarios.
// - Serializacao API: `Number(decimalValue)` no service antes de retornar
//   (frontend so trabalha com number).
// - Comparacoes SQL: use `_sum: { amount: true }` ou `_avg` no aggregate
//   em vez de comparar decimais via JS apos SELECT (economiza round-trip).
// - WHERE por Decimal: filtra como string no raw query (`amount = '100.50'`).
// ==========================================
// ==========================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ==========================================
// 1. GESTÃO DE IDENTIDADE E COMPLIANCE
// ==========================================

model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid()) // UUID público para segurança na API

  // Acesso
  email     String @unique
  oldEmails Json? // Array de emails antigos para auditoria
  nome      String
  senha     String
  role      Role   @default(USER)

  // Dados Pessoais
  telefone        String?
  data_nascimento DateTime?
  genero          Genero?

  // Endereço
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?
  cep         String?
  pais        Int?
  bandeira    String?
  pais_legacy Json?
  paisCountry Country? @relation("UserPais", fields: [pais], references: [id], onDelete: SetNull, onUpdate: Cascade)

  termosAceitos  Boolean @default(false)
  politicaAceita Boolean @default(false)

  // Dados Documentais (Simples)
  tipo_documento TypeDocumento?
  reg_documento  String?

  // Status de Conta
  isActive             Boolean  @default(true)
  // H2 (Fase A): flag que forca troca de senha no proximo login. Setada pelo
  // dismiss-session quando user reporta login desconhecido, ou por admin em
  // eventos de seguranca. Limpa apos troca de senha com sucesso.
  requirePasswordReset Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // BUG-FT-005: registra a última rejeição admin de KYC (REJECTED ou
  // NEEDS_RESUBMISSION) para o frontend /profile exibir "Faça upload novamente"
  // mesmo quando o KYCProfile já foi deletado pelo cleanup. Limpo quando o
  // user re-envia com sucesso (decisão APPROVED).
  lastKycRejectionAt     DateTime?
  lastKycRejectionReason String?
  lastKycRejectionSlot   String? // "avatar" | "documento" | "biofacial" | "comprovante"

  avatar_id      Int?
  avatar         KYCProfile? @relation(fields: [avatar_id], references: [id], name: "Avatar")
  comprovante_id Int?
  comprovante    KYCProfile? @relation(fields: [comprovante_id], references: [id], name: "Comprovante")
  documento_id   Int?
  documento      KYCProfile? @relation(fields: [documento_id], references: [id], name: "Documento")
  biofacial_id   Int?
  biofacial      KYCProfile? @relation(fields: [biofacial_id], references: [id], name: "Biofacial")

  // Consentimento biométrico explícito (LGPD Art. 11 I)
  biofacialConsentAt      DateTime?
  biofacialConsentVersion String? // "v1.0-2026-08-22"

  // --- RELACIONAMENTOS ---
  wallet   Wallet?
  payments Payment[]

  // S18.7 — ordens de pagamento (nova modelagem Order+Items).
  paymentOrders PaymentOrder[] @relation("PaymentOrderUser")

  // Pagamentos que este user (operador FINANCEIRO/ADMIN) aprovou manualmente
  paymentsApprovedManually Payment[] @relation("PaymentManualApprover")

  // Documentos de startup que este user (founder) uploadou
  uploadedStartupDocuments   StartupDocument[]       @relation("StartupDocumentUploader")
  reviewedStartupDocuments   StartupDocument[]       @relation("StartupDocumentReviewer")
  createdStartupDocumentNAs  StartupDocumentNA[]     @relation("StartupDocumentNACreator")
  reviewedStartupDocumentNAs StartupDocumentNA[]     @relation("StartupDocumentNAReviewer")
  campaignExtensionsCreated  CampaignExtension[]     @relation("CampaignExtensionCreator")
  // Decisões de auditoria (aprovar/rejeitar) tomadas por este admin.
  reviewDecisionsMade        StartupReviewDecision[] @relation("StartupReviewDecisionAdmin")
  // Solicitações de documentos extras feitas pelo compliance (AC-07)
  documentRequestsRequested  DocumentRequest[]       @relation("DocumentRequestRequester")

  // SaaS
  subscriptions Subscription[]

  // Notificações in-app (P2.11 — antes era Map em memória, agora persiste)
  notifications Notification[]

  // Business (Fundador)
  startups      Startup[]      @relation("FounderStartups")
  startupDrafts StartupDraft[] @relation("StartupDrafts")

  // Pinning manual (Marketplace S1): startups que este user pinou como ADMIN/COMPLIANCE
  manuallyPinnedStartups Startup[] @relation("ManuallyPinnedByUser")

  // Business (Investidor)
  investments       Investment[]
  tokens            Token[]            @relation("InvestorTokens")
  tokenHistory      TokenHistory[]
  tokenReservations TokenReservation[] @relation("UserTokenReservations")
  uploads           Upload[]
  /// Posts de transparencia que o usuario (founder) publicou.
  transparencyPosts TransparencyPost[] @relation("TransparencyPostAuthor")

  /// Threads de Discussao criadas por este usuario (sprint TRANSP-03).
  discussionsAuthored TransparencyDiscussion[] @relation("AuthorDiscussions")

  /// Threads que este usuario fixou (founder/admin) - apenas a mais recente conta.
  discussionsPinned TransparencyDiscussion[] @relation("PinnedByUser")

  /// Replies de Discussao escritas por este usuario (sprint TRANSP-03).
  repliesAuthored TransparencyReply[] @relation("AuthorReplies")

  /// Upvotes dados por este usuario em Discussao (sprint TRANSP-03).
  upvotes DiscussionUpvote[] @relation("UpvoteUsers")

  // Auditoria
  auditLogs   AuditLog[] // Ações que este usuário realizou
  accessLogs  AccessLog[] // Logs de acesso do usuário
  loginAlerts LoginAlert[]

  // Telemetria de prova de vida (liveness) associada às capturas biofaciais
  livenessTelemetries LivenessTelemetry[]

  // Template biométrico facial (embedding cifrado). 0..1 por usuário.
  faceBiometric FaceBiometric?

  // Solicitações de alteração de dados (como solicitante)
  dataChangeRequestsRequested DataChangeRequest[] @relation("DataChangeRequestRequester")
  // Solicitações de alteração de dados (como revisor)
  dataChangeRequestsReviewed  DataChangeRequest[] @relation("DataChangeRequestReviewer")

  // Programa de afiliados
  affiliations Affiliation[]       @relation("UserAffiliations")
  referredBy   AffiliateReferral[] @relation("InvestorReferrals")

  // === FIN-09: Repasse ===
  // Approvals de Compliance em deliberações de repasse
  complianceRepassessApproved   Repasse[]            @relation("ComplianceRepasseApprover")
  // Configurações de Financeiro em repasses
  financeiroRepassessConfigured Repasse[]            @relation("FinanceiroRepasseConfigurer")
  // InstallmentRequests como fundador
  installmentRequestsFounded    InstallmentRequest[] @relation("InstallmentRequestFounder")
  // InstallmentRequests aprovados
  installmentRequestsApproved   InstallmentRequest[] @relation("InstallmentRequestApprover")
  // InstallmentRequests rejeitados
  installmentRequestsRejected   InstallmentRequest[] @relation("InstallmentRequestRejecter")

  // === EMAIL TEMPLATES ===
  // Templates de email criados por este usuário
  emailTemplatesCreated     EmailTemplate[]        @relation("EmailTemplateCreator")
  // Versões de template criadas por este usuário
  templateVersionsCreated   EmailTemplateVersion[] @relation("VersionCreator")
  // Versões de template publicadas por este usuário
  templateVersionsPublished EmailTemplateVersion[] @relation("VersionPublisher")

  // === CUPONS DE DESCONTO ===
  // Cupons criados por este usuário (ADMIN/FINANCEIRO)
  couponsCreated Coupon[]      @relation("CouponCreator")
  // Usos de cupom por este usuário (LGPD auditoria)
  couponUsages   CouponUsage[] @relation("CouponUsageUser")
}

model BackupUser {
  id        Int           @id @default(autoincrement())
  userId    Int
  process   BackupProcess
  data      Json?
  createdAt DateTime      @default(now())
}

enum BackupProcess {
  ADMIN
  UPDATE
  DELETE
}

model EmailValidation {
  id        Int            @id @default(autoincrement())
  email     String
  token     String         @unique
  userId    Int?
  type      ValidationType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([email])
  @@index([token])
}

enum ValidationType {
  REGISTRATION
  UPDATE
  PASSWORD_RESET
}

model KYCProfile {
  id           Int     @id @default(autoincrement())
  originalName String
  size         Int
  mineType     String // é o mime type do arquivo ex: "image/png", "application/pdf"
  extension    String // Ex: "png", "jpg", "pdf"
  url          String // URL pública estável do arquivo original
  url_sm       String? // legado: alias da versão web
  url_md       String? // URL pública da versão média
  url_web      String? // URL pública otimizada para web
  url_lg       String? // legado: alias do original

  status          KYCStatus @default(PENDING)
  rejectionReason String? // Motivo da reprovação

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  avatar_user      User[]   @relation("Avatar")
  comprovante_user User[]   @relation("Comprovante")
  documento_user   User[]   @relation("Documento")
  biofacial_user   User[]   @relation("Biofacial")

  // Startups que usam este KYCProfile como logo
  startups               Startup[] @relation("Logo")
  // Startups que usam este KYCProfile como cover
  coverOf                Startup[] @relation("Cover")
  // Startups que usam este KYCProfile como documentos CVM
  mieOf                  Startup[] @relation("MIE")
  contratoSocialOf       Startup[] @relation("ContratoSocial")
  cnpjOf                 Startup[] @relation("CNPJ")
  balancoAtualOf         Startup[] @relation("BalancoAtual")
  declaracaoVeracidadeOf Startup[] @relation("DeclaracaoVeracidade")
  ataEleicaoOf           Startup[] @relation("AtaEleicao")
  balancoAnteriorOf      Startup[] @relation("BalancoAnterior")
  procuracaoOf           Startup[] @relation("Procuracao")
  cvSociosOf             Startup[] @relation("CvSocios")
  pitchDeckOf            Startup[] @relation("PitchDeck")
  projecoesOf            Startup[] @relation("Projecoes")
  modeloContratoOfertaOf Startup[] @relation("ModeloContratoOferta")
  comprovanteEnderecoOf  Startup[] @relation("ComprovanteEndereco")
  declaracaoReceitaOf    Startup[] @relation("DeclaracaoReceita")
}

/// Telemetria da prova de vida (liveness) capturada no cliente durante o envio
/// da selfie biofacial. Fase 2 do plano de evolução de liveness. NÃO contém
/// template biométrico (isso é a Fase 5, modelo FaceBiometric) — apenas sinais
/// agregados que dão auditabilidade à decisão de Compliance.
model LivenessTelemetry {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  /// Dono da captura.
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Upload biofacial (KYCProfile) ao qual esta telemetria se refere.
  kycProfileId Int?

  /// Sinais agregados do LivenessResult (client-side).
  passed              Boolean // gravação aceita (sem rejectionReasons)
  blinkCount          Int      @default(0)
  hasGlasses          Boolean? // null = indeterminado
  maxYawDeg           Float    @default(0)
  maxPitchDeg         Float    @default(0)
  landmarkMovement    Float    @default(0) // landmarkMovementScore
  avgRelativeMovement Float    @default(0)
  durationMs          Int      @default(0)
  mimeType            String?
  /// Instruções sorteadas e se foram satisfeitas (JSON).
  instructions        Json?
  /// Tempo de resposta por desafio concluído (JSON) — sinal DF-CAPTCHA de tempo.
  challengeResponseMs Json?
  /// Motivos de rejeição, quando houver (JSON de strings).
  rejectionReasons    Json?
  /// Fase 4: suspeita de câmera virtual/injeção (heurística, auditoria).
  injectionSuspicious Boolean  @default(false)
  injectionReasons    Json?
  /// Hash do user-agent (LGPD: não guardamos UA cru). Ajuda anti-fraude.
  userAgentHash       String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([kycProfileId])
  @@index([createdAt])
}

/// Template biométrico facial (embedding) — Fase 5 do plano de liveness.
///
/// LGPD Art. 11 (dado sensível): o template NUNCA é armazenado em texto plano.
/// `templateEnc` guarda o vetor cifrado (AES-256-GCM); `iv` e `authTag` são os
/// parâmetros da cifra. A extração acontece no SERVIDOR (anti-tamper), a partir
/// do arquivo biofacial real, com extrator plugável (Noop → ONNX/ArcFace).
///
/// Gravado apenas com consentimento válido (`consentVersion`) e PURGADO na
/// revogação (Art. 18 IX).
model FaceBiometric {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  /// 1:1 com User.
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Vetor de embedding cifrado (AES-256-GCM) + parâmetros da cifra.
  templateEnc String
  iv          String
  authTag     String

  /// Metadados do template (não sensíveis).
  modelVersion String // ex: "noop-v0", "arcface-r100-v1"
  dim          Int // dimensão do vetor (ex: 512)
  templateHash String // SHA-256 do vetor em claro (auditoria/dedup, não reversível)

  /// Versão do consentimento sob o qual foi capturado.
  consentVersion String?

  /// Upload biofacial de origem.
  kycProfileId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Role {
  USER
  ADMIN
  FINANCEIRO
  COMPLIANCE
  INVESTOR
  FOUNDER
}

enum Genero {
  HOMEM
  MULHER
  OUTRO
}

enum TypeDocumento {
  // Documentos Brasileiros
  CPF
  CNH
  // Documentos Internacionais
  PASSAPORTE
  CÉDULA_IDENTIDADE
  CARTEIRA_MOTORISTA
  DNI
  CUIT
  RUT
  SSN
  NATIONAL_ID
  BIRTH_CERTIFICATE
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_RESUBMISSION
}

// ==========================================
// 2. CARTEIRA E SALDOS (LEDGER)
// ==========================================

model Wallet {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  // Saldo Disponível (Cuidado nas transações)
  balance  Decimal @default(0.00)
  blocked  Decimal @default(0.00) // Saldo bloqueado em ordens abertas
  currency String  @default("BRL")

  transactions WalletTransaction[]

  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id Int @id @default(autoincrement())

  walletId Int
  wallet   Wallet @relation(fields: [walletId], references: [id])

  type        WalletType // CRÉDITO ou DÉBITO
  amount      Decimal
  description String

  // Rastreabilidade (De onde veio o dinheiro?)
  relatedPaymentId Int? // Se veio de um depósito via PIX
  relatedInvestId  Int? // Se foi compra de token

  createdAt DateTime @default(now())
}

// enum WalletType (Novos tipos de movimentação)
enum WalletType {
  DEPOSIT // Depósito via PIX (Entrada de dinheiro novo)
  WITHDRAWAL // Saque para conta bancária
  INVESTMENT // Compra de Tokens (Saída)
  SUBSCRIPTION // Pagamento de Plano (Saída)

  // Novos tipos:
  CAMPAIGN_SETTLEMENT // Founder recebe o valor arrecadado (Entrada)
  DIVIDEND_EXIT // Investor recebe parte do Exit/Lucros (Entrada)
  P2P_SALES // Venda de tokens para outro usuário (Entrada)
  P2P_PURCHASE // Compra de tokens de outro usuário (Saída)
  AFFILIATE_COMMISSION // Afiliado recebe comissão por venda atribuída (Entrada)
}

// ==========================================
// 3. PLANOS E ASSINATURAS (SaaS)
// ==========================================

model Plan {
  id        Int     @id @default(autoincrement())
  nome      String
  slug      String  @unique // Ex: "investor_pro"
  descricao String?

  preco        Decimal
  periodoMeses Int     @default(12)
  periodo      String  @default("/ano")

  icon        String?
  beneficios  Json?
  visivel     Boolean @default(true)
  isActive    Boolean @default(true)
  recomendado Boolean @default(false)
  textoBotao  String?

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  planId Int
  plan   Plan @relation(fields: [planId], references: [id])

  status SubStatus @default(PENDING)

  startedAt DateTime?
  expiresAt DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum SubStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

// ==========================================
// 3.1 CATEGORIA E ÁREA DE ATUAÇÃO (ADR-007 M7-S20)
// ==========================================

/// Categoria ampla usada em filtros de marketplace.
/// Relaciona-se com AreaAtuacao (hierarquia 1:N) e Startup (N:N via FKs).
model Category {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  nome      String
  descricao String?
  ativo     Boolean @default(true)
  ordem     Int     @default(0)

  /// Áreas de atuação pertencentes a esta categoria
  areas    AreaAtuacao[]
  /// Startups que pertencem a esta categoria (via FK)
  startups Startup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

/// Área de atuação específica (nicho) pertencente a uma Category.
///用来 expandir a taxonomia de forma granular sem precisar de nova migration.
model AreaAtuacao {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  nome       String
  descricao  String?
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  ativo      Boolean  @default(true)
  ordem      Int      @default(0)

  /// Startups que pertencem a esta área de atuação (via FK)
  startups Startup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("areas_atuacao")
}

// ==========================================
// 4. STARTUPS E CAMPANHAS (Core)
// ==========================================

model Startup {
  id Int @id @default(autoincrement())

  founderId Int
  founder   User @relation("FounderStartups", fields: [founderId], references: [id])

  /// Posts de transparencia publicados pelo founder para os investidores com token.
  transparencyPosts TransparencyPost[]

  /// Solicitações de parcelas de repasse (FIN-09).
  installmentRequests InstallmentRequest[]

  /// Threads de Discussao da area de Transparencia (sprint TRANSP-03).
  discussions TransparencyDiscussion[] @relation("StartupDiscussions")

  nome          String
  slug          String  @unique
  razao_social  String?
  cnpj          String  @unique
  site          String?
  telefone      String?
  email         String?
  pais          Json?
  redes_sociais Json?

  // Pitch
  area_atuacao  String?
  /// IDs das áreas de atuação selecionadas (JSON). Mantém areaAtuacaoId como legado.
  areas_atuacao Json?
  category      StartupCategory?

  // FKs relacionais (ADR-007) — coexistems com campos legados durante transicao
  categoryId          Int?
  areaAtuacaoId       Int?
  categoryRel         Category?    @relation(fields: [categoryId], references: [id])
  areaAtuacaoRel      AreaAtuacao? @relation(fields: [areaAtuacaoId], references: [id])
  /// Flag indicando que o mapeamento de area_atuacao para categoryId/areaAtuacaoId
  /// precisa de revisao manual (valores ambguos ou sem correspondencia no mapeamento).
  needs_manual_review Boolean      @default(false)
  estagio             String?
  descricao           String?
  problema            String?
  solucao             String?
  modelo_receita      String?
  descritivo_basico   String?
  youtube_url         String?

  // Dados complementares CVM (MIE) — preenchidos na tela de captação
  diferencial          String?
  mercado_alvo         String?
  espera_alcancar      String?
  dedicacao            String?
  compradores          String?
  investimento_previo  String?
  concorrencia         String?
  oferece_lucros       Boolean @default(false)
  lucros_descricao     String?
  oferece_beneficios   Boolean @default(false)
  beneficios_descricao String?

  // Estrutura
  socios       Json?
  teams        Json?
  uso_recursos Json?

  // Dados Bancários para Recebimento (Repasse)
  banco             String?
  agencia           String?
  conta             String?
  digito            String?
  tipo_conta        String? // "corrente" | "poupanca"
  pix_key           String?
  titular           String?
  documento_titular String? // CPF/CNPJ do titular da conta

  data_fundacao DateTime?

  logo_id Int?
  logo    KYCProfile? @relation("Logo", fields: [logo_id], references: [id])

  cover_id Int?
  cover    KYCProfile? @relation("Cover", fields: [cover_id], references: [id])

  // Documentos CVM obrigatórios
  mie_id Int?
  mie    KYCProfile? @relation("MIE", fields: [mie_id], references: [id])

  contrato_social_id Int?
  contrato_social    KYCProfile? @relation("ContratoSocial", fields: [contrato_social_id], references: [id])

  cnpj_id       Int?
  cnpj_document KYCProfile? @relation("CNPJ", fields: [cnpj_id], references: [id])

  balanco_atual_id Int?
  balanco_atual    KYCProfile? @relation("BalancoAtual", fields: [balanco_atual_id], references: [id])

  declaracao_veracidade_id Int?
  declaracao_veracidade    KYCProfile? @relation("DeclaracaoVeracidade", fields: [declaracao_veracidade_id], references: [id])

  ata_eleicao_id Int?
  ata_eleicao    KYCProfile? @relation("AtaEleicao", fields: [ata_eleicao_id], references: [id])

  // Documentos CVM condicionais
  balanco_anterior_id Int?
  balanco_anterior    KYCProfile? @relation("BalancoAnterior", fields: [balanco_anterior_id], references: [id])

  procuracao_id Int?
  procuracao    KYCProfile? @relation("Procuracao", fields: [procuracao_id], references: [id])

  cv_socios_id Int?
  cv_socios    KYCProfile? @relation("CvSocios", fields: [cv_socios_id], references: [id])

  // Documentos recomendados
  pitch_deck_id Int?
  pitch_deck    KYCProfile? @relation("PitchDeck", fields: [pitch_deck_id], references: [id])

  projecoes_id Int?
  projecoes    KYCProfile? @relation("Projecoes", fields: [projecoes_id], references: [id])

  modelo_contrato_oferta_id Int?
  modelo_contrato_oferta    KYCProfile? @relation("ModeloContratoOferta", fields: [modelo_contrato_oferta_id], references: [id])

  comprovante_endereco_id Int?
  comprovante_endereco    KYCProfile? @relation("ComprovanteEndereco", fields: [comprovante_endereco_id], references: [id])

  declaracao_receita_id Int?
  declaracao_receita    KYCProfile? @relation("DeclaracaoReceita", fields: [declaracao_receita_id], references: [id])

  // Status

  status StartupStatus @default(PENDING_RESERVATION_PAYMENT)

  // Founder contratou o serviço de Fast Track Review na reserva de tokens
  // (S18.6). Marcado quando o Payment FAST_TRACK_REVIEW vinculado ao mesmo
  // StartupDraft é confirmado PAID. Usado para priorização da fila de
  // análise do compliance e exibido na listagem admin.
  fastTrackReview     Boolean   @default(false)
  fastTrackReviewedAt DateTime?

  // Selo de verificação (independente do status de campanha)
  verificationStatus VerificationStatus @default(NOT_REQUESTED)

  // Score manual (0-100) para ordenação no Marketplace.featured
  score Int @default(0)

  // Pinning manual (RF-01): ADMIN/COMPLIANCE podem pinar ate 3 startups
  // para destaque no Marketplace. Sprint S1.
  manuallyPinned       Boolean   @default(false)
  manuallyPinnedBy     Int?
  manuallyPinnedAt     DateTime?
  manuallyPinnedReason String?

  manuallyPinnedByUser User? @relation("ManuallyPinnedByUser", fields: [manuallyPinnedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Cache do score 0..100 calculado por job diario + listeners (Sprint S2).
  scoreBreakdown        Json?
  scoreLastCalculatedAt DateTime?

  // Flag binario para destacar startups aceleradas (parcerias com aceleradoras).
  // Filtro do endpoint publico GET /api/startup/marketplace/accelerated.
  isAccelerated Boolean @default(false)

  // Dados de EXIT (Quando a startup é vendida ou faz IPO)
  isExited        Boolean   @default(false)
  exitValuation   Decimal? // Valor total da venda da empresa
  exitDate        DateTime?
  exitDescription String? // Detalhes da negociação para os investidores

  // Relacionamentos
  campaigns          Campaign[]
  issuedTokens       Token[]
  withdrawals        Withdrawal[] // Pedidos de saque do fundador
  seals              StartupSeal[]
  opinions           StartupOpinion[]
  curatedPicks       CuratedPick[]
  documents          StartupDocument[]
  documentNAs        StartupDocumentNA[]
  documentRejections StartupDocumentRejection[]
  documentRequests   DocumentRequest[]
  uploads            Upload[]
  signedDocuments    SignedDocument[]
  dataChangeRequests DataChangeRequest[]
  // Histórico de decisões de auditoria (aprovar/rejeitar por fase).
  reviewDecisions    StartupReviewDecision[]

  // Programa de afiliados
  affiliateProgram AffiliateProgram?

  // B12 — Repasse de Fundos
  notaFiscais   NotaFiscal[]
  fundTransfers FundTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([manuallyPinned, score(sort: Desc)])
  @@map("startups")
}

/// Documentos da startup (contrato social, CNPJ, balanço, pitch deck, etc).
/// Arquivos físicos vivem no bucket `document` do MinIO (S3Service); aqui
/// só persistimos metadados + chave de acesso.
model StartupDocument {
  id Int @id @default(autoincrement())

  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  categoria StartupDocumentCategory
  nome      String // Nome de exibição (o arquivo original ou rótulo dado pelo founder)
  s3Key     String                  @unique // Chave no bucket (`startup-<id>/<uuid>.<ext>`)
  mimetype  String
  sizeBytes Int

  uploadedById Int
  uploadedBy   User @relation("StartupDocumentUploader", fields: [uploadedById], references: [id])

  // === Revisão do Compliance/Admin por documento (fluxo_startup §2) ===
  // Todo documento nasce PENDING_REVIEW; o Admin/Compliance marca APPROVED ou
  // REJECTED (com justificativa). Aditivo/nullable para preservar dados antigos.
  reviewStatus DocumentReviewStatus @default(PENDING_REVIEW)
  reviewNote   String? // Justificativa (obrigatória na rejeição)
  reviewedAt   DateTime?
  reviewedById Int?
  reviewedBy   User?                @relation("StartupDocumentReviewer", fields: [reviewedById], references: [id])

  // Requests de documento que este doc atende (AC-07)
  documentRequests DocumentRequest[] @relation("DocumentRequestFulfilledDoc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startupId])
}

/// Status de revisão de um StartupDocument pelo Admin/Compliance (fluxo §2).
enum DocumentReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Histórico de rejeições de documentos da startup (fluxo §2).
///
/// Diferente de `StartupDocument.reviewStatus` (que muta no doc), esta tabela
/// preserva o histórico APÓS o hard-delete do documento rejeitado (ver
/// `AdminService.reviewStartupDocument` caso REJECTED). É a fonte de verdade
/// do banner vermelho exibido ao founder em `/founder/startups/:id/edit/documentos`.
///
/// Resolvida (resolvedAt != null) quando o founder faz upload de um novo
/// documento na mesma categoria.
model StartupDocumentRejection {
  id Int @id @default(autoincrement())

  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  categoria    StartupDocumentCategory
  documentName String // Snapshot pré-delete do nome do arquivo rejeitado
  reason       String // Justificativa (>=20 chars, <=500 chars, validado no service)

  rejectedById Int  // admin/compliance que rejeitou (sem FK para preservar auditoria se User sair)
  rejectedAt   DateTime @default(now())

  /// Quando o founder re-envia um doc na mesma categoria, este campo é setado
  /// e o banner some no frontend.
  resolvedAt DateTime?

  @@index([startupId, categoria, resolvedAt])
  @@index([startupId, resolvedAt])
}

/// Marcação "Não se aplica" estruturada por categoria de documento
/// (fluxo_startup §2). Substitui o antigo marcador improvisado (PDF fake
/// "não_se_aplica.pdf"). Só é permitida em categorias NÃO-essenciais
/// (condicionais/recomendados/outros — validado no service). A justificativa
/// é obrigatória e revisada pelo Compliance junto com os demais documentos.
model StartupDocumentNA {
  id        Int     @id @default(autoincrement())
  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  categoria     StartupDocumentCategory
  justificativa String // "Por que este documento não se aplica à sua startup?"

  // Revisão do Compliance (mesma semântica do StartupDocument).
  reviewStatus DocumentReviewStatus @default(PENDING_REVIEW)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById Int?
  reviewedBy   User?                @relation("StartupDocumentNAReviewer", fields: [reviewedById], references: [id])

  createdById Int
  createdBy   User @relation("StartupDocumentNACreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startupId, categoria])
  @@index([startupId])
  @@map("startup_document_na")
}

/// Decisões de auditoria sobre uma startup (aprovar/rejeitar).
///
/// Criada toda vez que um admin/compliance aprova ou rejeita a startup em
/// uma das fases (1 = cadastro+reserva, 2 = docs, 3 = tese+benefícios).
///
/// Quando `decision = REJECTED`, o snapshot dos campos da startup NO MOMENTO
/// DA REJEIÇÃO é gravado em `rejectedSnapshot` (JSON). O frontend compara
/// esse snapshot com o estado atual para destacar campo-a-campo o que o
/// founder atualizou após a rejeição (fluxo admin-startups-phases §5.3).
///
/// Para `decision = APPROVED`, `rejectedSnapshot` fica null.
model StartupReviewDecision {
  id Int @id @default(autoincrement())

  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  /// Fase do fluxo admin que originou a decisão (1, 2 ou 3).
  phase Int

  /// Decisão: APPROVED ou REJECTED.
  decision String

  /// Justificativa obrigatória em REJECTED (min 20 chars — LGPD).
  /// Opcional em APPROVED.
  justification String?

  /// Quem decidiu (snapshot do nome/email no momento, além do FK).
  /// `adminName`/`adminEmail` são desnormalizados para que a UI mostre
  /// "Aprovado por X" mesmo se o User for deletado depois (LGPD).
  adminUserId Int?
  admin       User?   @relation("StartupReviewDecisionAdmin", fields: [adminUserId], references: [id])
  adminName   String?
  adminEmail  String?

  /// Snapshot dos campos da startup no momento da rejeição (REJECTED only).
  /// Permite diff field-by-field quando o founder atualizar o cadastro.
  rejectedSnapshot Json?

  /// IP do admin que tomou a decisão (auditoria Art. 37 LGPD).
  ip String?

  createdAt DateTime @default(now())

  @@index([startupId, phase, createdAt])
  @@map("startup_review_decisions")
}

/// Categorias de documento conforme CVM Resolução 88/2022 (equity
/// crowdfunding). Agrupadas pela UI em 4 níveis (obrigatórios /
/// condicionais / recomendados / outros) — ver
/// `frontend/app/components/founder/documents-section.tsx`.
enum StartupDocumentCategory {
  // Obrigatórios CVM
  MIE
  CONTRATO_SOCIAL
  CNPJ
  BALANCO_ATUAL
  DECLARACAO_VERACIDADE
  ATA_ELEICAO

  // Condicionais (empresa > 1 ano / signatário ≠ admin / etc)
  BALANCO_ANTERIOR
  PROCURACAO
  CV_SOCIOS

  // Recomendados
  PITCH_DECK
  PROJECOES
  MODELO_CONTRATO_OFERTA
  COMPROVANTE_ENDERECO
  DECLARACAO_RECEITA

  // Plataforma + livre
  TERMO_PLATAFORMA
  OUTRO
}

enum StartupStatus {
  PENDING
  PENDING_RESERVATION_PAYMENT
  RESERVATION_PAID
  // Cadastro completo (seções 2 e 3); Taxa de Compliance gerada e aguardando pagamento (fluxo_startup §4).
  AWAITING_COMPLIANCE_FEE
  PENDING_CURATOR_REVIEW
  // Taxa de Compliance PAID + tudo validado; startup submetida ao gate final do Compliance (fluxo_startup §5).
  PENDING_APPROVAL
  APPROVED
  LIVE
  REJECTED
  DECLINED
}

enum VerificationStatus {
  NOT_REQUESTED
  PENDING
  VERIFIED
  REJECTED
}

enum StartupCategory {
  FINTECH
  AI
  SAAS
  HEALTHTECH
  EDTECH
  BIOTECH
  OTHER
}

// ==========================================
// 4.1 USO DE RECURSOS — ALOCACAO DE CATEGORIA POR CAMPANHA (M7-S21)
// ==========================================

/// Categorias de alocacao de recursos para campanhas de crowdfunding.
/// D8: uso_recursos relacional — cada Campaign tera N linhas em
/// CampaignResourceAllocation com soma 100%.
enum ResourceCategory {
  FUNDADOR
  DESENVOLVIMENTO
  COMERCIAL
  MARKETING
  NUVEM
  JURIDICO
  RESERVA_CAIXA
  CUSTOMIZADO
}

model Campaign {
  id Int @id @default(autoincrement())

  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id])

  title String

  // Financeiro da Oferta
  targetAmount  Decimal
  minInvestment Decimal
  valuation     Decimal

  // Regra do Token
  tokenPrice  Decimal
  totalTokens Int
  tokensSold  Int     @default(0)

  deadline DateTime
  status   CampaignStatus @default(OPEN)

  investments  Investment[]
  tokens       Token[]
  reservations TokenReservation[]
  extensions   CampaignExtension[]

  // Comissão do afiliado desta RODADA (5 ou 10). O fundador informa na abertura
  // da rodada e o valor é congelado — não muda depois de lançada. A apuração da
  // comissão usa este percentual (fallback para o do programa em rodadas antigas).
  affiliateCommissionPct Decimal?

  reservationFeePaid Boolean @default(false)

  // === SPRINT S01: Snapshots financeiros (ADR-008) ===
  // Snapshot gravado na criacao da campanha para reconstruir cálculos
  // históricos sem depender de configs que podem mudar no tempo.
  // Migration: nullable → backfill → MODIFY NOT NULL (3 cols).
  // Schema em nullable ate S01.2 (calculo implementado em requestNewRound).
  adminFeeValue       Decimal? // 20% da meta (snapshot)
  tokenBaseValue      Decimal? // valor de face do token
  tokenSellPrice      Decimal? // preço de venda (= base * (1 + fee))
  tokenMintingCost    Decimal? // custo de geração (tokens * mintFee)
  complianceFeeBilled Boolean  @default(false) // taxa cobrada após status=FUNDED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  payments Payment[]

  // S18.7 — ordens de pagamento associadas à campanha (taxa de compliance,
  // fast deploy, prorrogação, early access).
  paymentOrders PaymentOrder[]

  // D8: uso_recursos relacional — alocacoes de recursos por categoria
  resources CampaignResourceAllocation[]

  // === CAMPOS CVM/COMPLIANCE (M7-S22) ===
  // Resolução CVM 88/2022 — dados de lançamento e objetivo
  dataLancamentoRodada DateTime? // Quando a rodada entra em captação ativa
  objetivoCaptacao     String? // Para que a rodada existe (10-500 chars)
  oQueEsperaAlcancar   String? // Metas concretas (10-500 chars)

  // Lucros e benefícios
  participacaoLucros      Boolean  @default(false) // Gatilho para distribuição
  faturamentoMinimoLucros Decimal? // Gatilho anual se lucros=true
  /// Política de participação nos lucros em texto livre (10-2000 chars).
  /// Quando `participacaoLucros=true`, o founder descreve aqui os termos
  /// (gatilho anual, forma de cálculo, periodicidade de distribuição).
  /// Validado no DTO UpdateCampaignDto (MinLength/MaxLength).
  politicaLucros          String?
  beneficiosAdicionais    Boolean  @default(false) // Há benefícios além dos lucros
  beneficiosDescricao     String? // Descrição dos benefícios

  // Termos e declarações
  aceiteTermoRepasse   Boolean @default(false) // Art. 7º, V LGPD
  declaracaoVeracidade Boolean @default(false) // Art. 6º, IX LGPD

  // === CAMPOS DE CAPTACAO (realocados de Startup === Campaign) ===
  problema           String? // Pitch: problema que resolve
  solucao            String? // Pitch: solucao proposta
  modeloReceita      String? // Pitch: modelo de receita
  diferencial        String? // Pitch: diferencial competitivo
  mercadoAlvo        String? // Pitch: mercado alvo
  sociosCount        Int? // Numero de socios
  dedicacao          String? // Dedicacao do fundador (integral/parcial)
  compradores        String? // Quem sao os compradores
  investimentoPrevio String? // Investimento ja realizado
  concorrencia       String? // Analise de concorrencia

  // B12 — Repasse de Fundos
  totalRaised          Decimal? // Calculado dos investments CONFIRMED
  transferStarted      Boolean  @default(false) // Se repasse já foi iniciado
  repasseConfigured    Boolean  @default(false) // Se financeiro já configurou parcelas
  repasseParcelas      Int      @default(12) // Nº de parcelas definido pelo financeiro
  repasseIntervaloDias Int      @default(30) // Intervalo entre parcelas (dias)

  // Auditoria de aceite CVM
  auditLogs CampaignOfferAuditLog[]

  // Ordens de emissão de tokens (pós-aprovação compliance)
  issuanceOrders TokenIssuanceOrder[]

  // === PUBLICAÇÃO (delay pós-aprovação Fase 3 / FAST_DEPLOY) ===
  // Por padrão, após a aprovação da Fase 3 pelo Compliance a startup só é
  // publicada no marketplace 24h depois. `scheduledPublishAt` guarda o horário
  // alvo da publicação; a campanha permanece DRAFT até o cron de publicação
  // agendada transicioná-la para OPEN quando `scheduledPublishAt <= now`.
  scheduledPublishAt DateTime?
  // `fastDeploy=true` quando o founder contratou o serviço "Publicação Rápida"
  // (Payment FAST_DEPLOY PAID). Nesse caso a publicação é imediata na aprovação
  // (OPEN na hora, sem agendamento de 24h).
  fastDeploy         Boolean  @default(false)

  // === FIN-09: Repasse (1:1 por campanha) ===
  repasse Repasse?
}

enum CampaignStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  FUNDED
  PAID_OUT
}

/// Prorrogação da captação (PRD_RECEBIMENTO §6.3 / admin-payout-management §13).
/// O founder define o valor adicional; a reserva de tokens é calculada apenas
/// sobre o adicional. Ao confirmar o pagamento da reserva (Payment
/// TOKEN_RESERVATION_EXTENSION → PAID), a campanha é reativada (OPEN) com a
/// meta somada. Não adiciona valores ao enum CampaignStatus (decisão do PRD).
model CampaignExtension {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  additionalAmount Decimal // Valor adicional a captar (R$)
  totalAmountShown Decimal // Nova meta somada (meta original + adicional) — read-only
  tokenReserve     Int // Reserva de tokens calculada só sobre o adicional
  periodDays       Int     @default(30) // Novo período de captação (Compliance)

  // Ciclo: PENDING_RESERVATION_PAYMENT → RESERVATION_PAID → REACTIVATED.
  status String @default("PENDING_RESERVATION_PAYMENT")

  // Pagamento da reserva adicional (1:1). Nullable até criar a cobrança.
  paymentId Int?     @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdById Int
  createdBy   User @relation("CampaignExtensionCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@map("campaign_extensions")
}

/// D8: Alocacao de recurso por categoria para uma Campaign.
/// Cada linha = 1 categoria + percentual (1-100). Soma por campaign = 100.
/// UNIQUE(campaignId, categoria) impede duplicacao (idempotencia no backfill).
model CampaignResourceAllocation {
  id                   Int              @id @default(autoincrement())
  campaignId           Int
  campaign             Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  categoria            ResourceCategory
  percentual           Int // 1-100 (validado em DTO/service)
  descricaoCustomizada String? // obligatorio quando categoria=CUSTOMIZADO
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([campaignId, categoria])
  @@index([campaignId])
  @@map("campaign_resource_allocations")
}

// ==========================================
// 4.2 AUDITORIA DE ACEITE CVM (M7-S22 T039)
// ==========================================
// Log imutável de aceite de termos CVM em ofertas de crowdfunding.
// Registrado quando aceiteTermoRepasse ou declaracaoVeracidade mudam para true.

model CampaignOfferAuditLog {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  action     String // "ACEITE_TERMO_REPASSE" ou "DECLARACAO_VERACIDADE"
  ip         String?
  userAgent  String?
  userId     Int?
  occurredAt DateTime @default(now())

  @@index([campaignId])
  @@map("campaign_offer_audit_logs")
}

/// Compliance pode pedir documentos extras ao founder durante a curadoria
/// (Resolução CVM 88/2022 — Art. 7º, V). O founder recebe notificação
/// (email + in-app), faz upload via StartupDocument e a request é marcada
/// como FULFILLED com link para o documento enviado.
model DocumentRequest {
  id            Int     @id @default(autoincrement())
  startupId     Int
  startup       Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  requestedById Int
  requestedBy   User    @relation("DocumentRequestRequester", fields: [requestedById], references: [id])

  /// Categoria sugerida (ex.: "BALANCO_ATUALIZADO", "CONTRATO_SOCIAL")
  /// ou texto livre para casos fora do catálogo.
  type        String
  description String
  deadline    DateTime?

  status DocumentRequestStatus @default(PENDING)

  /// Vinculado quando o founder faz upload do StartupDocument solicitado.
  fulfilledDocId Int?
  fulfilledDoc   StartupDocument? @relation("DocumentRequestFulfilledDoc", fields: [fulfilledDocId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startupId])
  @@index([status])
  @@index([requestedById])
  @@map("document_requests")
}

enum DocumentRequestStatus {
  PENDING
  FULFILLED
  EXPIRED
  CANCELED
}

// ==========================================
// 5. EQUITY & TOKENS (Ativos Digitais)
// ==========================================

model Token {
  id String @id @default(uuid())

  // Identificador único do contrato digital
  hash        String  @unique
  certificate String? // URL do PDF gerado

  // Lastros
  userId Int
  user   User @relation("InvestorTokens", fields: [userId], references: [id])

  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id])

  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  /// Investimento que originou este token. Nullable para tokens legados
  /// emitidos antes deste vínculo. Distingue múltiplos aportes do mesmo
  /// investidor numa mesma campanha (certificado/valorização por aporte).
  investmentId Int?
  investment   Investment? @relation(fields: [investmentId], references: [id])

  // Valores
  quantity    Int      @default(1)
  purchaseVal Decimal
  currentVal  Decimal?

  dtAquisicao DateTime @default(now())
  updatedAt   DateTime @updatedAt

  history TokenHistory[]

  @@index([userId])
  @@index([startupId])
  @@index([investmentId])
}

model TokenHistory {
  id Int @id @default(autoincrement())

  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  type        TransType
  amount      Decimal?
  description String?

  createdAt DateTime @default(now())
}

enum TransType {
  BUY_MARKET
  SELL_P2P
  DIVIDEND
  DILUTION
}

// ==========================================
// 6. PAGAMENTOS (C6 Bank) & SAQUES
// ==========================================
//
// S18.7 — DEPRECATED. O modelo Payment é mantido temporariamente para
// retrocompat durante o cutover. A nova source-of-truth é `PaymentOrder`
// (modelo Order+Items) — novos checkouts são escritos em ambos via
// `_createOrderWithItems` (dual-write). Payments legados foram migrados
// para PaymentOrder pelo script `scripts/backfill-payment-orders.ts`.
//
// CUTOVER PLANEJADO (Fase 6.5):
//   1. Marcar `LEGACY_PAYMENT_DROPPED=true` via env (default false)
//   2. Helper `_createOrderWithItems` para de criar Payment legado
//   3. Prisma removido gradualmente de todos os services
//   4. Migration SQL final: DROP TABLE Payment, DROP TABLE
//      StartupDraft (consolidado na Order)
//
// Por enquanto, manter o modelo. Não dropar em prod sem antes:
//   - Validar que todos os consumers leem de PaymentOrder
//   - Confirmar com 30 dias de bake-time em prod
//   - Manter backup do DB (LGPD)

model Payment {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Destino do Pagamento
  subscriptionId Int?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  investmentId Int?        @unique // Relação 1:1 com Investimento
  investment   Investment? @relation(fields: [investmentId], references: [id])

  // TIPO DE PAGAMENTO (Fundamental para diferenciar as regras)
  purpose PaymentPurpose

  // Dados Financeiros
  amount Decimal
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  // Breakdown financeiro do item (auditoria + relatórios).
  // - originalAmount: valor cheio do produto/serviço ANTES de qualquer desconto
  //   (ex.: R$ 500 reserva, R$ 2.500 fast track). Igual a `amount` quando não há desconto.
  // - discountAmount: desconto aplicado a ESTE item (cupom compartilhado é rateado
  //   proporcionalmente ao originalAmount de cada Payment no mesmo checkout).
  // - paidAmount: valor EFETIVAMENTE pago deste item (originalAmount - discountAmount).
  //   Igual a `amount` em todos os fluxos atuais; campo reservado para extensões
  //   futuras (taxas intermediárias, estornos parciais).
  originalAmount Decimal?
  discountAmount Decimal?
  paidAmount     Decimal?

  // Integração EFI Bank (substitui C6)
  // txid NÃO é @unique: um PIX consolidado (ex.: reserva + fast track) gera
  // 1 cobrança EFI e 1 txid compartilhado por 2 Payments (TOKEN_RESERVATION
  // + FAST_TRACK_REVIEW). Mantemos índice para lookup O(1) no webhook.
  txid             String? // 26 chars max, alfanumérico (EFI Pix)
  endToEndId       String?   @unique // SPI BACEN id
  efiChargeId      String?   @unique // ID de cobrança na API Cobranças (cartão)
  efiLocation      String? // URL do QR Code dinâmico (location do /v2/cob)
  qrCodeBase64     String?
  copyPastePix     String?
  paidAt           DateTime?
  // Marco de aplicação dos EFEITOS de domínio (ver schema.prisma). A
  // idempotência/reconciliação se ancoram aqui, não em status===PAID.
  effectsAppliedAt DateTime?
  expiresAt        DateTime? // expiração do QR (cob.calendario.expiracao)

  // RELACIONAMENTOS (Destinos)
  // Para INVESTIMENTO de terceiros
  campaignId Int? // Para TAXA DE RESERVA (Founder pagando)
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // Metadados para serviços avulsos (ex: Early Access)
  serviceDetails Json? // Ex: { product: "EARLY_ACCESS", couponId, principal, installments, interestRate, totalWithInterest }

  // Aprovação manual pelo painel /financeiro
  manualApprovedById   Int?
  manualApprovedBy     User?     @relation("PaymentManualApprover", fields: [manualApprovedById], references: [id])
  manualApprovedAt     DateTime?
  manualJustification  String?
  manualComprovanteKey String? // chave no bucket `comprovante` do S3/MinIO

  // Estorno
  refundedAt   DateTime?
  refundedById Int?
  refundReason String?
  refundTxid   String? // txid da devolução EFI

  // Cupom aplicado
  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação inversa com StartupDraft (1:1 — TOKEN_RESERVATION)
  startupDraft          StartupDraft?      @relation("StartupDraftPrimary")
  // Relação inversa com StartupDraft (1:1 — FAST_TRACK_REVIEW)
  startupDraftFastTrack StartupDraft?      @relation("StartupDraftFastTrack")
  // Relação inversa com CampaignExtension (1:1 — prorrogação)
  campaignExtension     CampaignExtension?

  // S18.7 — vínculo para a nova PaymentOrder. Quando um bundle (RESERVA +
  // FastTrack ou COMPLIANCE + FastDeploy) gera 2 Payments legados, o
  // primeiro (âncora) tem paymentGroupId = seu próprio id; o segundo tem
  // paymentGroupId = id da âncora. A PaymentOrder é a fonte da verdade do
  // estado (status/paidAt/txid) e dos itens; este campo mantém a referência
  // retroativa até o cutover da Fase 6 (drop table Payment).
  paymentGroupId Int?
  paymentGroup   Payment?  @relation("PaymentGroup", fields: [paymentGroupId], references: [id], onDelete: SetNull)
  groupMembers   Payment[] @relation("PaymentGroup")

  // PERF: next-action do dashboard busca reserva PENDING por campanha
  // (campaign.startupId + status=PENDING + purpose=TOKEN_RESERVATION).
  @@index([campaignId, status])
  // PERF: listagens por usuário com ordenação por data (admin/financeiro/transactions).
  @@index([userId, createdAt])
  // S18.7 — busca de siblings do mesmo bundle durante dual-write e backfill.
  @@index([paymentGroupId])
}

enum PaymentPurpose {
  SUBSCRIPTION // Usuário pagando plano mensal
  INVESTMENT // Investidor comprando tokens
  TOKEN_RESERVATION // Founder pagando para criar os tokens (Os 5%)
  EARLY_ACCESS // Compra do acesso antecipado (5k)
  P2P_BUY // Compra de tokens de outro usuário (B2B)
  VERIFICATION_SEAL // Pagamento da taxa de selo Startup Verificada (R$ 890,00)
  COMPLIANCE_FEE // Taxa de Compliance da startup (gate da Etapa/Fase 2 — fluxo_startup §4/§4B)
  TOKEN_RESERVATION_EXTENSION // Reserva adicional na prorrogação da captação (PRD_RECEBIMENTO §6.3)
  FAST_TRACK_REVIEW // Análise prioritária (compliance Fast Track) — produto adicional no checkout da reserva de tokens. Compartilha txid com TOKEN_RESERVATION (1 PIX consolidado, 2 Payments distintos para auditoria).
  FAST_DEPLOY // Publicação Rápida — produto adicional no checkout da Taxa de Compliance. Torna a publicação da startup imediata na aprovação da Fase 3 (em vez do delay padrão de 24h). Compartilha txid com COMPLIANCE_FEE (1 PIX consolidado, 2 Payments distintos para auditoria).
}

// ==========================================
// S18.7 — PAYMENT ORDER + ITEMS (fonte da verdade do pagamento)
// ==========================================
// Refator do modelo de pagamento consolidado. Antes: 1 ordem de pagamento
// (ex.: COMPLIANCE_FEE + FAST_DEPLOY) gerava 2 Payment records irmãos
// com estado independente, permitindo o bug "1 PAID + 1 PENDING". Depois:
// 1 PaymentOrder tem N PaymentItems, e o estado é携带 na Order (atomic).
//
// Migração em background (Fase 4) popula estas tabelas a partir dos
// Payments legados. Payment é mantido como dual-write durante a transição
// (Fases 2-5) e removido no cutover da Fase 6.

model PaymentOrder {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation("PaymentOrderUser", fields: [userId], references: [id])

  // Estado centralizado — 1 ordem = 1 ato de pagar (regra de negócio S18.7).
  // Itens herdam este estado atomicamente.
  status PaymentStatus @default(PENDING)

  // Método de pagamento escolhido (PIX ou CREDIT_CARD).
  method PaymentMethod

  // Totais calculados a partir dos itens (Σ).
  totalAmount   Decimal // Σ(items.subtotal) — valor final após cupom
  totalOriginal Decimal // Σ(items.originalSubtotal) — antes do cupom
  totalDiscount Decimal @default(0) // totalOriginal - totalAmount

  // Cupom aplicado (rateado entre os itens).
  couponCode    String?
  couponId      Int?
  couponPercent Int?

  // Identificadores do gateway (PIX: txid + endToEndId; Cartão: efiChargeId).
  txid        String? @unique
  endToEndId  String? @unique
  efiChargeId String? @unique

  expiresAt        DateTime?
  paidAt           DateTime?
  effectsAppliedAt DateTime?

  // Relações de domínio (Subscription, Investment, etc.) via items.
  campaignId Int?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  startupDraftId Int?      @unique
  startupDraft   StartupDraft? @relation("PaymentOrderStartupDraft", fields: [startupDraftId], references: [id], onDelete: SetNull)

  items PaymentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PERF: listagens por usuário com ordenação por data.
  @@index([userId, createdAt])
  @@index([status, paidAt])
  @@index([campaignId])
}

/// Cada item de uma PaymentOrder. qty=1 para serviços avulsos (RESERVA,
/// FastTrack, FastDeploy, Compliance) e qty=N para compra de tokens
/// (15 tokens de uma startup = 1 item com quantity=15).
model PaymentItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  purpose     PaymentPurpose
  description String? // ex: "Tokens <Startup X>"

  // Breakdown financeiro por item.
  unitPrice        Decimal  // preço por unidade
  quantity         Int      @default(1)
  subtotal         Decimal  // unitPrice × quantity (após cupom rateado)
  originalSubtotal Decimal  // valor antes do cupom
  discountAmount   Decimal  @default(0) // parte do cupom que caiu neste item

  // Metadados específicos do item (ex: dados de investidor, contexto de serviço).
  serviceDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([purpose])
}

model Investment {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  /// Subtotal dos tokens (tokensQty x preco de venda). O total cobrado do
  /// investidor (subtotal + taxa da plataforma) fica em Payment.amount.
  amount    Decimal
  tokensQty Int

  // ---------------------------------------------------------------------
  // Split financeiro (snapshot imutavel gravado na criacao do pedido;
  // `allocatedAt` carimba a confirmacao do pagamento). Nullable: investimentos
  // legados anteriores ao split nao possuem os campos — agregacoes devem usar
  // `startupRepasseAmount ?? amount`.
  // ---------------------------------------------------------------------

  /// Preco base (valor de face) do token no momento da compra.
  tokenBasePrice Decimal?

  /// Preco de venda efetivamente cobrado por token.
  tokenSellPrice Decimal?

  /// tokensQty x tokenSellPrice (espelha `amount`, gravado para clareza).
  tokenSubtotal Decimal?

  /// Aliquota da taxa da plataforma vigente na compra (fracao, ex: 0.05).
  platformFeePct Decimal?

  /// tokenSubtotal x platformFeePct — cobrada do investidor no checkout.
  platformFeeAmount Decimal?

  /// tokensQty x tokenBasePrice — valor liquido devido a startup.
  startupRepasseAmount Decimal?

  /// tokenSubtotal - startupRepasseAmount — ganho da plataforma no spread.
  platformSpreadAmount Decimal?

  /// platformSpreadAmount + platformFeeAmount — receita total da plataforma
  /// neste investimento.
  platformRevenueAmount Decimal?

  /// Comissao de afiliado devida (base: startupRepasseAmount), gravada na
  /// confirmacao. Espelha AffiliateCommission.affiliateAmount.
  affiliateCommissionAmount Decimal?

  /// Carimbo da confirmacao do pagamento (mesma transaction de
  /// confirmInvestment). NULL enquanto PENDING.
  allocatedAt DateTime?

  // Ligação inversa com pagamento é feita no model Payment
  payment Payment?

  /// Código de afiliado digitado no checkout. Tem precedência sobre o vínculo
  /// gravado pelo link de indicação na hora de atribuir a comissão.
  affiliateCode String?

  // Comissão de afiliado apurada na confirmação (no máximo uma por investimento)
  affiliateCommission AffiliateCommission?

  // Reserva de tokens que segura o estoque enquanto o pagamento não confirma.
  reservation TokenReservation?

  // Tokens emitidos na confirmação deste investimento.
  tokens Token[]

  status    InvStatus @default(PENDING)
  createdAt DateTime  @default(now())

  // PERF: agregações do dashboard do founder filtram por campanha + status
  // (sum de CONFIRMED por campaignId) e contam investidores únicos por userId.
  // Sem estes índices o SQLite fazia full scan da tabela Investment.
  @@index([campaignId, status])
  @@index([userId])
  // PERF: listagens por usuário com ordenação por data (my-startups, statements).
  @@index([userId, createdAt])
}

model Withdrawal {
  id Int @id @default(autoincrement())

  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id])

  amount Decimal

  // Dados destino (Snapshot para segurança)
  bankInfo Json // { banco: "001", ag: "...", cc: "..." }

  status WithdrawalStatus @default(REQUESTED)

  approvedBy   Int? // Admin ID
  txIdBancario String? // ID da TED/PIX enviada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
  // QR Code/Pix expirado (24h) sem pagamento; a startup/ordem NÃO é deletada
