model WebhookLog {
  id       String @id @default(cuid())
  provider String @default("EFI_BANK")

  eventType   String? // "pix.received" | "card.paid" | "card.failed" | etc
  txid        String? // txid do EFI
  endToEndId  String? // endToEndId do Pix
  efiChargeId String?

  // HMAC-SHA256 do CPF (anonimizado para queries)
  cpfHash  String?
  // HMAC-SHA256 do CNPJ (anonimizado para queries)
  cnpjHash String?

  amount Decimal?

  status    String // SUCCESS | ERROR
  errorCode String? // code EFI
  errorLog  String?

  payload String? // Payload bruto do webhook

  // Payload bruto criptografado em S3 (SSE-KMS)
  payloadS3Key     String? // s3://bucket/webhooks/<id>.json
  payloadS3Bucket  String? // nome do bucket
  payloadExpiresAt DateTime? // lifecycle 90 dias

  processed   Boolean   @default(false)
  processedAt DateTime?
  retryCount  Int       @default(0)
  ipAddress   String? // já validado por IP whitelist

  // Idempotência: hash(txid + eventType) para evitar duplicidade
  idempotencyKey String? @unique

  receivedAt DateTime @default(now())

  @@index([txid])
  @@index([cpfHash])
  @@index([eventType, receivedAt])
  @@map("webhook_logs")
}

