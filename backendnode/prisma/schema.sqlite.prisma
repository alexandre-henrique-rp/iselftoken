// ==========================================
// 17. B12 — REPASSE DE FUNDOS
// ==========================================
// Notas fiscais e transferências parceladas para repasse de
// fundos arrecadados em campanhas de equity crowdfunding.

enum NotaFiscalStatus {
  PENDING
  ISSUED
  CANCELED
}

enum FundTransferStatus {
  AWAITING_REQUEST
  REQUESTED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum RepasseStatus {
  CONFIGURED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Nota fiscal emitida pela startup para repasse de fundos.
/// Cada NF representa o valor total a ser repassado e agrupa
/// as parcelas de transferência (FundTransfer).
model NotaFiscal {
  id        Int              @id @default(autoincrement())
  startupId Int
  startup   Startup          @relation(fields: [startupId], references: [id])
  number    String           @unique // NF number sequencial (ex: "NF-2026-000001")
  amount    Decimal
  issuedAt  DateTime         @default(now())
  status    NotaFiscalStatus @default(PENDING)
  xmlUrl    String? // S3 presigned URL do XML da NF

  fundTransfers FundTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startupId])
  @@index([status])
  @@map("nota_fiscais")
}

/// Transferência parcelada de fundos para a startup.
/// O repasse é dividido em N parcelas configuráveis pelo financeiro (default 12).
/// Cada parcela passa pelo fluxo: AWAITING_REQUEST → REQUESTED → PROCESSING → COMPLETED.
model FundTransfer {
  id                Int                @id @default(autoincrement())
  startupId         Int
  startup           Startup            @relation(fields: [startupId], references: [id])
  notaFiscalId      Int
  notaFiscal        NotaFiscal         @relation(fields: [notaFiscalId], references: [id])
  installmentNumber Int // 1..N (conforme configurado pelo financeiro)
  amount            Decimal
  scheduledDate     DateTime? // Preenchido quando financeiro aprova (null enquanto AWAITING_REQUEST)
  status            FundTransferStatus @default(AWAITING_REQUEST)
  paidAt            DateTime?
  txIdBancario      String? // ID da transação no gateway C6

  // Alocação de recursos preenchida pelo fundador na solicitação
  allocation      Json? // { marketing, desenvolvimento, infraestrutura, pessoal, juridico, operacional, reservaCaixa }
  observacao      String? // Justificativa livre do fundador
  rejectionReason String? // Motivo da rejeição pelo financeiro

  requestedAt DateTime? // Quando o fundador solicitou
  approvedAt  DateTime? // Quando o financeiro aprovou
  approvedBy  Int? // ID do admin que aprovou/rejeitou

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notaFiscalId, installmentNumber]) // Uma parcela por número por NF
  @@index([startupId])
  @@index([status])
  @@index([scheduledDate])
  @@map("fund_transfers")
}

// ==========================================
// FIN-09: REPASSE, PARCELA, SOLICITACAO
// ==========================================

/// Plano de repasse de uma campanha FUNDED. Compliance delibera a QUANTIDADE
/// de parcelas, Financeiro configura o VALOR FIXO por parcela + INTERVALO.
/// 1 Repasse por Campaign (campaignId UNIQUE).
model Repasse {
  id         Int      @id @default(autoincrement())
  campaignId Int      @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Compliance delibera
  numeroParcelas             Int       @default(12)
  complianceApprovedAt       DateTime?
  complianceApprovedByUserId Int?
  complianceApprovedBy       User?     @relation("ComplianceRepasseApprover", fields: [complianceApprovedByUserId], references: [id])
  complianceObservacao       String?

  // Financeiro configura
  valorParcela                 Decimal   @default(0)
  valorUltimaParcela           Decimal?
  intervaloDias                Int       @default(30)
  /// Intervalo entre a data de configuracao e a PRIMEIRA parcela.
  /// Permite um ramp-up (ex.: "primeira em 7 dias, demais a cada 30")
  /// quando a campanha acabou de ser finalizada. Nullable para preservar
  /// repasses legados — quando null, fallback = `intervaloDias`.
  primeiraParcelaDias          Int?
  valorTotalCaptacao           Decimal   @default(0)
  financeiroConfiguredAt       DateTime?
  financeiroConfiguredByUserId Int?
  financeiroConfiguredBy       User?     @relation("FinanceiroRepasseConfigurer", fields: [financeiroConfiguredByUserId], references: [id])

  status          RepasseStatus @default(CONFIGURED)
  cancelledAt     DateTime?
  cancelledMotivo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments Installment[]

  @@index([campaignId])
  @@index([status])
  @@map("repasses")
}

/// Parcela individual de um Repasse. Status inicial AWAITING_REQUEST
/// (herda do enum FundTransferStatus ja existente — reuso).
model Installment {
  id        Int     @id @default(autoincrement())
  repasseId Int
  repasse   Repasse @relation(fields: [repasseId], references: [id], onDelete: Cascade)

  numero        Int       @default(1)
  valor         Decimal
  scheduledDate DateTime?
  paidAt        DateTime?

  // PRD_RECEBIMENTO §9 / admin-payout §4.3 — comprovante anexado pelo
  // Financeiro/Admin ao marcar a parcela como paga; exibido na transparência.
  comprovanteUrl String?
  // Identificador genérico da transação de pagamento da parcela (TED/PIX).
  // Distinto de InstallmentRequest.txidC6 (específico da integração EFI).
  txId           String?

  // Reusa enum FundTransferStatus: AWAITING_REQUEST | REQUESTED | PENDING |
  // PROCESSING | COMPLETED | FAILED | REJECTED
  status FundTransferStatus @default(AWAITING_REQUEST)

  request InstallmentRequest?

  @@unique([repasseId, numero])
  @@index([repasseId])
  @@index([status])
  @@map("installments")
}

/// Solicitacao do fundador para receber uma parcela. Criada no `request`,
/// incrementando `attemptNumber` em resubmissoes. UNIQUE(installmentId)
/// para garantir 1 solicitacao ativa por parcela (reabrir = atualizar).
model InstallmentRequest {
  id            Int         @id @default(autoincrement())
  installmentId Int         @unique
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id])

  founderUserId Int
  founder       User @relation("InstallmentRequestFounder", fields: [founderUserId], references: [id])

  // Alocacao por % (campos nominais). SOMA deve dar 100% (validado no DTO).
  allocationPercents Json
  // Preenchido na aprovacao — convertido em R$ a partir de valorParcela × percent/100.
  allocationValues   Json?
  observacao         String?

  // Snapshot dos dados bancarios no momento da criacao.
  bankInfoSnapshot Json

  valorSolicitado Decimal

  // === Relatório do mês (obrigatório para solicitar) — PRD_RECEBIMENTO §8.2 ===
  // Publicado no relatório mensal da página de transparência ao salvar.
  // Nullable para preservar solicitações antigas criadas antes desta migração.
  usoRecurso             String? // Para onde o recurso será utilizado (alinhado à alocação 3A)
  teveLucro              Boolean? // A startup teve lucro neste período?
  marcoAlcancado         Boolean? // Alcançou algum marco/desenvolvimento?
  marcoDescricao         String? // Detalhe do marco (quando marcoAlcancado = true)
  mensagemInvestidores   String? // "Mensagem do mês" exibida na transparência
  publicadoTransparencia Boolean  @default(false) // Relatório já publicado na transparência

  // Status: AWAITING_SUBMISSION | REQUESTED | APPROVED | PROCESSING | COMPLETED | REJECTED
  status            String   @default("REQUESTED")
  submittedAt       DateTime @default(now())
  tsLimitePagamento DateTime

  attemptNumber Int @default(1)

  approvedAt           DateTime?
  approvedByUserId     Int?
  approvedBy           User?     @relation("InstallmentRequestApprover", fields: [approvedByUserId], references: [id])
  valorOverride        Decimal?
  observacaoFinanceiro String?

  rejectedAt       DateTime?
  rejectedByUserId Int?
  rejectedBy       User?     @relation("InstallmentRequestRejecter", fields: [rejectedByUserId], references: [id])
  rejectionReason  String?

  completedAt DateTime?
  txidC6      String?
  endToEndId  String?

  updatedAt DateTime @updatedAt

  @@index([installmentId])
  @@index([founderUserId])
  @@index([startupId])
  @@index([status])
  @@index([tsLimitePagamento])
  @@map("installment_requests")
}

// ==========================================
// 18. RESERVA DE TOKENS (Previne Oversell)
// ==========================================

/// Reserva que segura tokens de uma campanha enquanto o investidor conclui o
/// pagamento. Ciclo: RESERVED -> CONFIRMED (pago; tokens emitidos) ou
/// RESERVED -> DISCARDED (expirado/cancelado; estoque liberado).
/// A disponibilidade da campanha = totalTokens - tokensSold - reservas RESERVED.
model TokenReservation {
  id String @id @default(uuid())

  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation("UserTokenReservations", fields: [userId], references: [id])

  quantity Int

  status TokenReservationStatus @default(RESERVED)

  /// Investimento que originou a reserva (1:1). Nullable para reservas futuras
  /// que não venham de um investimento.
  investmentId Int?        @unique
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)

  expiresAt     DateTime
  confirmedAt   DateTime?
  discardedAt   DateTime?
  discardReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@index([userId])
  @@index([status, expiresAt])
  @@map("token_reservations")
}

enum TokenReservationStatus {
  RESERVED
  CONFIRMED
  DISCARDED
}

// ==========================================
// 19. PROGRAMA DE AFILIADOS
// ==========================================
// Funil em tres etapas:
//   1. Startup adere ao programa           -> aprovado pela admin iSelfToken
//   2. Usuario se candidata a afiliado      -> triado pelo fundador da startup
//   3. Admin da o aval final                -> prepara tokens e link de compra
// Sobre cada investimento atribuido a um afiliado a startup paga DUAS
// comissoes (ao afiliado e a iSelfToken), ambas descontadas do repasse.

/// Adesao de uma startup ao programa de afiliados (1:1 com Startup).
/// Os percentuais sao congelados aqui na aprovacao; os defaults vem de
/// FinanceConfig (`affiliate.defaultAffiliatePct` / `affiliate.defaultPlatformPct`).
model AffiliateProgram {
  id        Int     @id @default(autoincrement())
  startupId Int     @unique
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  status AffiliateProgramStatus @default(PENDING)

  /// Percentual pago ao afiliado sobre o valor do investimento atribuido.
  affiliateCommissionPct Decimal
  /// Percentual pago a iSelfToken sobre o mesmo valor.
  platformCommissionPct  Decimal

  /// Teto opcional de afiliados ativos simultaneos (null = sem limite).
  maxAffiliates Int?

  requestedAt    DateTime  @default(now())
  requestedBy    Int // founder User id
  decidedAt      DateTime?
  decidedBy      Int? // admin User id
  decisionReason String?

  affiliations Affiliation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("affiliate_programs")
}

enum AffiliateProgramStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// Vinculo de um usuario como afiliado de uma startup.
/// Percorre PENDING_FOUNDER -> PENDING_ADMIN -> ACTIVE.
model Affiliation {
  id        Int              @id @default(autoincrement())
  programId Int
  program   AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation("UserAffiliations", fields: [userId], references: [id])

  status AffiliationStatus @default(PENDING_FOUNDER)

  /// Codigo de indicacao: usado no link (/affiliate/track/:code) e como
  /// override digitado no checkout.
  code String @unique

  /// Alocado pelo fundador na etapa 2 (triagem); preservado na ativacao.
  tokensAllocated Int?
  purchaseLinkUrl String?

  appliedAt        DateTime  @default(now())
  founderDecidedAt DateTime?
  founderDecidedBy Int?
  adminDecidedAt   DateTime?
  adminDecidedBy   Int?
  rejectionReason  String?

  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, userId])
  @@index([status])
  @@index([userId])
  @@map("affiliations")
}

enum AffiliationStatus {
  PENDING_FOUNDER
  PENDING_ADMIN
  ACTIVE
  REJECTED
  SUSPENDED
}

/// Investidor capturado por um afiliado. O vinculo por LINK e persistente;
/// CHECKOUT_CODE registra atribuicao explicita no momento de investir.
model AffiliateReferral {
  id            Int         @id @default(autoincrement())
  affiliationId Int
  affiliation   Affiliation @relation(fields: [affiliationId], references: [id], onDelete: Cascade)

  investorId Int
  investor   User @relation("InvestorReferrals", fields: [investorId], references: [id])

  source AffiliateReferralSource @default(LINK)

  createdAt DateTime @default(now())

  @@unique([affiliationId, investorId])
  @@index([investorId])
  @@map("affiliate_referrals")
}

enum AffiliateReferralSource {
  LINK
  CHECKOUT_CODE
}

/// Comissao devida por um investimento confirmado. Percentuais e valores sao
/// congelados na criacao para que mudanca posterior no programa nao altere
/// comissao ja apurada. Um investimento gera no maximo uma comissao.
model AffiliateCommission {
  id            Int         @id @default(autoincrement())
  affiliationId Int
  affiliation   Affiliation @relation(fields: [affiliationId], references: [id])

  investmentId Int        @unique
  investment   Investment @relation(fields: [investmentId], references: [id])

  /// Valor do investimento que serviu de base para o calculo.
  baseAmount Decimal

  affiliatePct    Decimal
  affiliateAmount Decimal
  platformPct     Decimal
  platformAmount  Decimal

  status AffiliateCommissionStatus @default(PENDING)

  /// Lancamento na carteira do afiliado quando a comissao e paga.
  walletTransactionId Int?

  attributedBy AffiliateReferralSource

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([affiliationId])
  @@index([status])
  @@map("affiliate_commissions")
}

enum AffiliateCommissionStatus {
  PENDING
  PAYABLE
  PAID
  CANCELED
}

// ==========================================
// 20. ORDEM DE EMISSÃO DE TOKENS (TokenIssuanceOrder)
// ==========================================
// Modelo para rastrear a ordem de emissão de tokens de uma campanha.
// Criada quando o Compliance aprova a startup + pagamento confirmado.
// Worker processa via SELECT ... FOR UPDATE SKIP LOCKED.
// Garante idempotência e auditabilidade da emissão.

enum TokenIssuanceOrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TokenIssuanceOrder {
  id String @id @default(uuid())

  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  /// Quantidade total de tokens a serem emitidos nesta ordem
  quantity Int

  /// Status da ordem: PENDING -> PROCESSING -> COMPLETED / FAILED
  status TokenIssuanceOrderStatus @default(PENDING)

  /// ID do operador de compliance que aprovou (gatilho da criação)
  approvedByUserId Int?

  /// Tentativas de processamento (para retry com backoff)
  attempts Int @default(0)

  /// Última mensagem de erro (se FAILED)
  lastError String?

  /// Timestamp de início de processamento (lock)
  processingStartedAt DateTime?

  /// Timestamp de conclusão (COMPLETED ou FAILED)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([campaignId])
  @@map("token_issuance_orders")
}

/// Post de transparencia publicado pelo founder para investidores.
/// Acessivel apenas para usuarios com Token ativo da startup (gating via TokenGateGuard).
/// Referencia: scripts/PRD_PAGINA_TRANSPARENCIA.md
model TransparencyPost {
  id Int @id @default(autoincrement())

  startupId Int
  startup   Startup @relation(fields: [startupId], references: [id])

  /// Autor do post (founder da startup ou ADMIN).
  /// Validado no service: authorId === req.user.id (founder da startup) OU ADMIN.
  authorId Int
  author   User @relation("TransparencyPostAuthor", fields: [authorId], references: [id])

  /// Tipo do post - usado para filtros no feed.
  type TransparencyPostType @default(GENERAL)

  /// Titulo do post (exibido no card e detalhe).
  title String

  /// Conteudo em markdown (renderizado no client via react-markdown com rehype-sanitize).
  /// Whitelist conservadora: sem HTML cru, sem scripts, sem iframes (XSS prevention).
  content String

  /// Periodo de referencia do post (nullable para posts sem periodo, ex: "Marcos do produto").
  periodMonth Int?
  periodYear  Int?

  /// Soft delete para preservar historico de auditoria.
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  /// Origem do post (rastreabilidade / idempotencia).
  /// - INSTALLMENT_REQUEST: auto-gerado por FIN-10 ao aprovar/concluir uma InstallmentRequest.
  ///   `sourceId` armazena o InstallmentRequest.id (convertido para String).
  /// - DISCUSSION: auto-gerado por TRANSP-03 (featured report mensal).
  ///   `sourceId` armazena o TransparencyDiscussion.id (UUID/string).
  /// O par (sourceType, sourceId) e UNIQUE: garante idempotencia de auto-posts.
  sourceType String?
  sourceId   String?

  /// Anexos do post (PDFs, planilhas, imagens) via modulo uploads.
  attachments TransparencyPostAttachment[]

  @@unique([sourceType, sourceId])
  @@index([startupId, publishedAt(sort: Desc)])
  @@index([startupId, type])
  @@index([startupId, periodYear, periodMonth])
  @@index([sourceType, sourceId])
}

/// Join table N:N entre TransparencyPost e Upload (anexos).
/// Cascade delete: ao deletar um post, remove os vinculos (uploads permanecem como orfaos para o cleanup job).
model TransparencyPostAttachment {
  postId   Int
  post     TransparencyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploadId Int
  upload   Upload           @relation(fields: [uploadId], references: [id])

  @@id([postId, uploadId])
  @@index([uploadId])
  @@map("transparency_post_attachments")
}

// ==========================================
// TRANSP-03 / TRANSP-05 — Discussao + Relatorio Vigente
// ==========================================

/// Taxonomia de categoria das threads de Discussao da area de Transparencia.
/// DEFAULT GERAL garante retrocompatibilidade com threads existentes.
enum DiscussionCategory {
  GERAL
  FINANCEIRO
  PRODUTO
  SOCIETARIO
  DUVIDA

  @@map("discussion_category")
}

/// Thread de Discussao aberta por um token-holder (ou founder) dentro da
/// area de Transparencia de uma startup. Suporta taxonomia, anonimato opt-in,
/// upvotes (1 por user/thread via DiscussionUpvote UNIQUE) e pin exclusivo
/// por startup (garantido por transacao no discussions.service.ts).
///
/// LGPD: respostas NUNCA devem incluir `User.cpf`, `User.email` ou
/// `User.phone` — authorPublicId eh derivado no service atraves de
/// `buildAuthorPublicId()` para preservar privacidade do opt-in anonymous.
///
/// Referencia: CASE.md §[Transparencia] - Discussao e Relatorio Vigente
///             todo/todo.json -> TRANSP-03 / TRANSP-05.
model TransparencyDiscussion {
  id String @id @default(uuid())

  startupId Int
  startup   Startup @relation("StartupDiscussions", fields: [startupId], references: [id], onDelete: Cascade)

  /// Autor da thread. User.id eh publico na camada de auth mas NUNCA exposto
  /// em DTOs de resposta; usamos apenas firstName/lastName/fullName via
  /// `buildAuthorPublicId()`.
  authorId Int
  author   User @relation("AuthorDiscussions", fields: [authorId], references: [id])

  title   String
  content String

  /// Taxonomia da discussao. Default GERAL permite criacao sem fornecer.
  category DiscussionCategory @default(GERAL)

  /// Opt-in de anonimato. Quando true, exibicao usa "PrimeiroNome U.".
  isAnonymous Boolean @default(false)

  /// Contador denormalizado para ordenacao "top". Atualizado atomicamente pelo
  /// service em `toggleUpvote()` dentro de transacao.
  upvotesCount Int @default(0)

  /// Flag de fixacao. No maximo 1 thread fixada por startup (constraint
  /// aplicada na logica de `pin()` via transaction).
  isPinned       Boolean   @default(false)
  pinnedAt       DateTime?
  pinnedByUserId Int?
  pinnedBy       User?     @relation("PinnedByUser", fields: [pinnedByUserId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete para auditoria.
  deletedAt DateTime?

  replies TransparencyReply[]
  upvotes DiscussionUpvote[]

  @@index([startupId])
  @@index([authorId])
  @@index([startupId, isPinned])
  @@index([startupId, createdAt])
  @@index([startupId, upvotesCount])
  @@map("transparency_discussions")
}

/// Resposta (reply) dentro de uma thread de Discussao. Soft delete para
/// preservar historico. Atualiza implicitamente `lastActivityAt` da thread
/// (campo derivado na query via MAX(replies.createdAt) ou updatedAt da thread).
model TransparencyReply {
  id String @id @default(uuid())

  discussionId String
  discussion   TransparencyDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation("AuthorReplies", fields: [authorId], references: [id])

  content String

  createdAt DateTime  @default(now())
  /// Soft delete para auditoria.
  deletedAt DateTime?

  @@index([discussionId])
  @@index([authorId])
  @@map("transparency_replies")
}

/// Upvote de um user em uma thread. UNIQUE(discussionId, userId) garante
/// idempotencia do toggle: 1 voto por user por thread.
///
/// O contador denormalizado `TransparencyDiscussion.upvotesCount` eh a fonte
/// de verdade para ordenacao "top"; este registro eh a fonte para
/// `viewerHasUpvoted` (existencia = voto ativo).
model DiscussionUpvote {
  id String @id @default(uuid())

  discussionId String
  discussion   TransparencyDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation("UpvoteUsers", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  /// Garante idempotencia do toggle upvote: 1 voto por (thread, user).
  @@unique([discussionId, userId])
  @@index([discussionId])
  @@index([userId])
  @@map("discussion_upvotes")
}

// ==========================================
// STARTUP DRAFT (Tabela temporária pré-pagamento)
// ==========================================

/// Armazena o payload completo de cadastro de startup ANTES do pagamento
/// ser confirmado. Quando o Payment associado muda para PAID, o worker
/// processa este draft e cria a Startup real + Campaign.
///
/// Fluxo:
///   1. Founder preenche formulário → POST /startup/draft
///   2. Backend cria Payment (TOKEN_RESERVATION) + salva payload aqui
///   3. Founder paga (simulado ou C6 real)
///   4. Webhook/worker detecta Payment PAID → busca draft por paymentId
///   5. Cria Startup + Campaign com dados do payload → status PENDING
///   6. Draft marcado como PROCESSED
model StartupDraft {
  id Int @id @default(autoincrement())

  founderId Int
  founder   User @relation("StartupDrafts", fields: [founderId], references: [id])

  paymentId Int     @unique
  payment   Payment @relation("StartupDraftPrimary", fields: [paymentId], references: [id])

  /// Pagamento adicional (Fast Track Review) vinculado ao mesmo checkout
  /// consolidado da reserva de tokens. Compartilha o mesmo txid EFI com o
  /// `payment` (TOKEN_RESERVATION), mas existe como Payment independente
  /// para que admin/compliance possam auditar a contratação do serviço
  /// separadamente. `null` quando o founder NÃO contratou Fast Track.
  fastTrackPaymentId Int?     @unique
  fastTrackPayment   Payment? @relation("StartupDraftFastTrack", fields: [fastTrackPaymentId], references: [id])

  /// Payload completo do formulário serializado em JSON.
  /// Contém todos os campos que serão usados para criar a Startup + Campaign.
  payload Json

  status StartupDraftStatus @default(PENDING_PAYMENT)

  /// S18.7 — PaymentOrder que consolidou a reserva + fast track neste draft.
  /// Substitui progressivamente as relations `payment` / `fastTrackPayment`
  /// acima. `null` para drafts pré-S18.7 (dual-read até cutover da Fase 6).
  paymentOrder PaymentOrder? @relation("PaymentOrderStartupDraft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StartupDraftStatus {
  PENDING_PAYMENT // Aguardando pagamento ser confirmado
  PROCESSING // Worker está processando (lock)
  PROCESSED // Startup criada com sucesso
  FAILED // Falha no processamento (payload inválido, etc)
}

/// P2.11 — Notificações in-app persistidas (substitui Map em memória do
/// NotificationsService). O backend era reiniciado em produção e perdia
/// todas as notificações. Migration: 20260908000000_add_notification_table.
model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  // Enum Prisma — integridade reforcada em 2 camadas:
  //  1. App-layer: NotificationType enum em TS (ver dto/query-notifications.dto.ts)
  //  2. Banco: triggers SQL (migration 20261011000000_notification_type_constraint)
  //     + CHECK constraint do Prisma (gerado a partir deste enum).
  //
  // IMPORTANTE: valores estao em snake_case (mesmo formato que o frontend ja
  // consome e que o WS Gateway serializa). Ver migration
  // 20261011010000_notification_type_enum.sql que faz o CAST para esses valores.
  // Lista (22 valores — alinhar com enum TS):
  //   kyc_approved, kyc_resubmission_requested,
  //   investment_confirmed, token_purchased,
  //   campaign_funded, campaign_deadline, campaign_closed,
  //   startup_approved, startup_rejected, startup_phase_approved, phase_approved,
  //   compliance_request, security, general,
  //   user_approved, user_suspended,
  //   plan_purchased, plan_added,
  //   repasse_request, repasse_approved, repasse_rejected, repasse_paid
  type        NotificationType @default(general)
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

/// Enum do campo Notification.type (Sprint de Notificacoes — central 2026-10-04).
/// Mesma lista que o `NotificationType` em `src/api/notifications/dto/`.
/// Valores em snake_case (alinhados com o frontend + WS payload + trigger SQL).
enum NotificationType {
  kyc_approved
  kyc_resubmission_requested
  investment_confirmed
  token_purchased
  campaign_funded
  campaign_deadline
  campaign_closed
  startup_approved
  startup_rejected
  startup_phase_approved
  phase_approved
  compliance_request
  security
  general
  user_approved
  user_suspended
  plan_purchased
  plan_added
  repasse_request
  repasse_approved
  repasse_rejected
  repasse_paid
}

// Alertas de novo login. Mantém apenas metadados minimizados e o estado do ciclo de vida.
model LoginAlert {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventKey                 String  @unique
  fingerprint              String
  trustedIp                String?
  ipClass                  String
  environment              String
  proxyChainTrusted        Boolean @default(false)
  deviceLabel              String?
  deviceBrowser            String?
  deviceOperatingSystem    String?
  deviceType               String?
  deviceHash               String?
  locationSource           String
  locationPrecision        String
  locationCountry          String?
  locationCity             String?
  locationRegion           String?
  locationLatitudeRounded  Float?
  locationLongitudeRounded Float?
  locationTimezone         String?
  locationOrg              String?
  locationHostname         String?
  accuracyBucketMeters     Int?
  reason                   String

  deliveryStatus     String    @default("PENDING")
  deliveryMessageId  String?
  deliveryError      String?
  actionStatus       String    @default("PENDING")
  actionTokenJtiHash String?   @unique
  actionExpiresAt    DateTime?
  confirmedAt        DateTime?
  dismissedAt        DateTime?
  sessionsDeleted    Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, actionStatus])
  @@index([deliveryStatus])
}
