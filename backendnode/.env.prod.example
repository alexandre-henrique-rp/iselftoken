# ============================================================
# .env.prod.example — IselfToken API (Apresentação / EC2 única)
#
# Copie para .env.prod e preencha os valores reais:
#   cp .env.prod.example .env.prod
#
# NOTA: As variáveis REDIS_HOST, REDIS_PORT, RABBITMQ_HOST,
# RABBITMQ_PORT, DATABASE_PROVIDER e DATABASE_URL são sobrescritas
# pelo docker-compose.prod.yml (environment). Defina aqui apenas
# como fallback/documentação.
# ============================================================

# ==========================================
# DATABASE (SQLite para apresentação)
# ==========================================
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:/app/data/iselftoken.db"

# ==========================================
# SERVIDOR
# ==========================================
PORT=7077

# ==========================================
# JWT (OBRIGATÓRIO — gere com: openssl rand -base64 48)
# Deixe vazio no template e preencha por um mecanismo seguro de secrets antes do deploy.
# Placeholders conhecidos são rejeitados e o backend falha no bootstrap sem um valor válido.
# ==========================================
JWT_SECRET=""
# Segredo separado para HMAC de anonimização de PII em logs de webhook.
WEBHOOK_HASH_SECRET=""
JWT_EXPIRES_IN="30m"

# ==========================================
# FRONTEND URL (CORS)
# ==========================================
# Coloque aqui o IP/domínio público da EC2 ou domínio do frontend
FRONTEND_URL="http://SEU_IP_PUBLICO:5173"

# URL pública do backend (para links em emails, uploads, etc.)
BACKEND_PUBLIC_URL="http://SEU_IP_PUBLICO:7077"

# ==========================================
# REDIS (gerenciado pelo docker-compose — não alterar)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# RABBITMQ (gerenciado pelo docker-compose — não alterar)
# ==========================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=""

# ==========================================
# AWS SES
# ==========================================
AWS_SES_FROM_EMAIL="noreply@iselftoken.com"
# Deve ser false após a conta SES receber acesso de produção
AWS_SES_SANDBOX=false

# ==========================================
# SMTP (AWS SES via SMTP)
# ==========================================
SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="noreply@iselftoken.com"
SMTP_REPLY_TO=""

# Destinatário de seed exibido no cabeçalho, mas não entregável (para testes)
SMTP_NON_DELIVERABLE_RECIPIENTS=""

# Emails de cópia (CC) para monitoramento
EMAIL_CC_LIST=""

# ==========================================
# AWS S3
# ==========================================
# Os buckets de produção estão na região us-east-1.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID="sua-access-key"
AWS_SECRET_ACCESS_KEY="seu-secret-key"
S3_BUCKET_PREFIX=iselftoken-prod
S3_PUBLIC_BASE_URL=
S3_PUBLIC_HOST=s3.us-east-1.amazonaws.com

# Upload presigned URL TTL (segundos) — 7 dias
UPLOAD_PRESIGNED_URL_TTL=604800

# ==========================================
# SENTRY (opcional — deixe vazio para desabilitar)
# ==========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_RELEASE=

# ==========================================
# EFI BANK
# ==========================================
EFI_MODE=mock
EFI_BASE_URL=https://api-pix-h.gerencianet.com.br
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_AUTH=
EFI_PIX_KEY=
EFI_WEBHOOK_URL=
EFI_DEFAULT_SPLIT_ID=
EFI_ENABLED=true
EFI_BANK_MIGRATION=false

# HMAC secret para validação de webhooks EFI (min 32 chars)
# Gerar: openssl rand -hex 32
EFI_WEBHOOK_HMAC_SECRET="trocar-por-valor-seguro-com-pelo-menos-32-caracteres"
