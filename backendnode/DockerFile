FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY yarn.lock ./
RUN yarn install
COPY . .
RUN yarn prisma generate
# Sincroniza generated/prisma -> node_modules/.prisma/client (postinstall hook
# roda antes do generate, entao sincronizamos manualmente agora).
RUN yarn prisma:sync
# RUN yarn seed
# RUN yarn seed:location
RUN yarn build

FROM node:20-alpine AS production
ENV NODE_ENV=production
WORKDIR /app
COPY package*.json ./
COPY yarn.lock ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/generated ./generated

EXPOSE 7077
CMD ["node", "dist/src/main"]
