# Backend API URL (NestJS)
VITE_API_URL=http://localhost:7077

# WebSocket URL (socket.io, namespace /notifications) para o realtime.
# Opcional. Fallback: VITE_API_URL (dev local funciona sem definir).
# Em produção atrás de proxy/CDN, aponte para a origem que faz o upgrade
# do WebSocket (ex.: https://api.seu-dominio.com.br). Deve bater com
# SOCKET_IO_CORS_ORIGINS do backend.
VITE_WS_URL=

# EFI — Identificador de Conta (payee_code) para tokenização de cartão no navegador
# Encontrado no painel EFI em: API > Introdução > Identificador de Conta.
# É um identificador público (não é segredo); usado pela lib payment-token-efi.
VITE_EFI_PAYEE_CODE=

# EFI — Ambiente de tokenização.
# PRECISA bater com EFI_MODE do backend (sandbox|prod). Se desalinhar, a EFI
# gera o token em um ambiente e o backend tenta usar em outro → 3500010.
# Default: sandbox se VITE_API_URL contém "localhost", production caso contrário.
# Em preview/homologação, setar explicitamente para evitar auto-detecção errada.
VITE_EFI_ENVIRONMENT=sandbox
